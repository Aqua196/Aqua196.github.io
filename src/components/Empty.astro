---
interface Props {
  /** 终端里“执行”的命令 */
  cmd?: string;
}
const { cmd = 'ls ./writeups' } = Astro.props;
---

<div class="empty mono" data-reveal>
  <p><span class="ps">$</span> {cmd}</p>
  <p class="dim">total 0</p>
  <p class="msg">这里还没有已发布的文章。<slot /></p>
</div>

<style>
  .empty {
    padding: 1.4rem 0 1.6rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }
  p {
    margin: 0.2rem 0;
  }
  .ps,
  .dim {
    color: var(--muted);
  }
  .msg {
    margin-top: 1rem;
    font-family: var(--font-body);
    color: var(--fg-2);
  }
</style>

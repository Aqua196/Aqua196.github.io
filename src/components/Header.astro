---
import { NAV, SITE } from '../config';
import { url } from '../utils/url';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const full = url(href).replace(/\/$/, '') || '/';
  return href === '/' ? path === full : path === full || path.startsWith(full + '/');
};
---

<header class="site-header" id="site-header">
  <div class="container bar">
    <a class="logo mono" href={url('/')} aria-label="回到首页">
      <span class="mark">&gt;_</span>
      <span data-scramble>{SITE.author}</span><span class="dim">/writeups</span>
    </a>

    <nav aria-label="主导航">
      <ul class="links" id="nav-links">
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href)} class:list={{ active: isActive(item.href) }}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <button class="act search-trigger mono" type="button" data-open-search aria-label="搜索 (Ctrl+K)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="hide-sm">搜索</span>
        <kbd class="hide-sm">/</kbd>
      </button>
      <button class="act" type="button" id="theme-toggle" aria-label="切换明暗主题">
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
      <button class="act menu-btn" type="button" id="menu-toggle" aria-label="菜单" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    font-size: 0.92rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .logo > :not(.mark) {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mark {
    flex: none;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    font-size: 0.75rem;
    background: var(--fg);
    color: var(--bg);
  }
  .dim {
    color: var(--muted);
    font-weight: 400;
  }
  nav {
    margin-left: auto;
  }
  .links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 0.3rem 0.8rem;
    font-size: 0.9rem;
    color: var(--fg-2);
    transition: color 0.15s, background 0.15s;
  }
  .links a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .links a.active {
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 34px;
    min-width: 34px;
    padding: 0 0.6rem;
    border: 1px solid var(--line-2);
    background: transparent;
    font-size: 0.8rem;
    color: var(--fg);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .act:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .act:hover kbd {
    color: inherit;
    border-color: currentColor;
  }
  #theme-toggle {
    position: relative;
  }
  #theme-toggle svg {
    transition: transform 0.4s var(--ease), opacity 0.2s;
  }
  #theme-toggle .moon {
    position: absolute;
  }
  :global([data-theme='dark']) #theme-toggle .sun {
    transform: rotate(-90deg) scale(0);
    opacity: 0;
  }
  :global([data-theme='light']) #theme-toggle .moon {
    transform: rotate(90deg) scale(0);
    opacity: 0;
  }
  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
  }
  .menu-btn span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease);
  }
  .menu-btn[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .hide-sm {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
    }
    .links {
      flex-direction: column;
      background: var(--bg);
      border-bottom: 1px solid var(--fg);
      clip-path: inset(0 0 100% 0);
      /* 收起时用 visibility 真正隐藏：Tab 不会跳进去，读屏也读不到 */
      visibility: hidden;
      transition:
        clip-path 0.3s var(--ease),
        visibility 0s 0.3s;
    }
    .links.open {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      transition:
        clip-path 0.3s var(--ease),
        visibility 0s;
    }
    .links a {
      padding: 0.9rem 16px;
      border-top: 1px solid var(--line);
      font-size: 1rem;
    }
    .actions {
      margin-left: auto;
    }
    .bar {
      gap: 0.75rem;
    }
  }
  @media (max-width: 420px) {
    .dim {
      display: none;
    }
    .act {
      min-width: 32px;
      height: 32px;
      padding: 0 0.45rem;
    }
  }
</style>

<script>
  function initHeader() {
    const menuBtn = document.getElementById('menu-toggle');
    const links = document.getElementById('nav-links');
    const themeBtn = document.getElementById('theme-toggle');

    const setOpen = (open: boolean) => {
      links?.classList.toggle('open', open);
      menuBtn?.setAttribute('aria-expanded', String(open));
    };
    menuBtn?.addEventListener('click', () => setOpen(!links?.classList.contains('open')));
    // Esc、点菜单外面都能收起
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && links?.classList.contains('open')) {
        setOpen(false);
        menuBtn?.focus();
      }
    };
    const onClick = (e: MouseEvent) => {
      const t = e.target as Node;
      if (links?.classList.contains('open') && !links.contains(t) && !menuBtn?.contains(t)) setOpen(false);
    };
    document.addEventListener('keydown', onKey);
    document.addEventListener('click', onClick);
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('click', onClick);
      },
      { once: true },
    );

    themeBtn?.addEventListener('click', (e) => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      const apply = () => {
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || reduce) return apply();

      // 从按钮位置画一个圆扩散到全屏
      const x = e.clientX || innerWidth - 40;
      const y = e.clientY || 30;
      const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.classList.add('theme-transition');
      const t = document.startViewTransition(apply);
      t.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          { duration: 600, easing: 'cubic-bezier(.2,.8,.2,1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
      t.finished.finally(() => root.classList.remove('theme-transition'));
    });
  }
  document.addEventListener('astro:page-load', initHeader);
</script>

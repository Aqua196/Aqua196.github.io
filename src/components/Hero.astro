---
import { SITE } from '../config';
import { url } from '../utils/url';

interface Props {
  postCount: number;
  categoryCount: number;
  tagCount: number;
}
const { postCount, categoryCount, tagCount } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
// ID 结尾的数字单独排成斜体：Aqua196 → Aqua + 196
const [, word = SITE.author, digits = ''] = /^(.*?)(\d+)$/.exec(SITE.author) ?? [];
---

<section class="hero" id="hero">
  <div class="dots" aria-hidden="true"></div>
  <canvas id="stage" aria-hidden="true"></canvas>
  <div class="container inner">
    <div class="grid">
      <div class="text">
        <p class="eyebrow label" data-reveal><i aria-hidden="true"></i>{SITE.subtitle}</p>
        <h1 class="name" aria-label={SITE.author}>
          {[...word].map((ch, i) => <span class="ch" aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}
          {
            digits && (
              <em>
                {[...digits].map((ch, i) => (
                  <span class="ch" aria-hidden="true" style={`--i:${word.length + i}`}>{ch}</span>
                ))}
              </em>
            )
          }
        </h1>
        <p class="lead" data-reveal style="--delay:.35s">{SITE.description}</p>
        <p class="typer mono" data-reveal style="--delay:.42s">
          <span class="prompt" aria-hidden="true">$</span>
          <span class="typed" id="typed" data-lines={JSON.stringify(SITE.taglines)}>{SITE.taglines[0]}</span><span
            class="caret"
            aria-hidden="true"></span>
        </p>
        <div class="cta" data-reveal style="--delay:.5s">
          <a class="btn btn-primary" href="#latest" data-magnetic>开始阅读 <span class="arr down" aria-hidden="true">↓</span></a>
          <a class="btn" href={url('/archive')} data-magnetic>全部归档 <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>

      <!-- 占位：雕塑画在整屏的 canvas 上，这个格子只用来告诉它“中心在哪、能画多大” -->
      <figure class="art" id="art">
        <figcaption class="mono" data-reveal style="--delay:.6s">
          <span class="cap-name">fig. <span id="model-idx">1</span> — <span id="model-name" aria-live="polite">trefoil knot</span></span>
          <span class="cap-note" id="model-note">crossing number = 3</span>
          <button type="button" class="cap-next" id="model-next" aria-label="切换到下一个模型">next <span aria-hidden="true">→</span></button>
        </figcaption>
      </figure>
    </div>

    <div class="foot">
      <div class="stats">
        <a href={url('/archive')}><span class="v" data-count={postCount}>{pad(postCount)}</span><span class="k">Writeups</span></a>
        <a href={url('/categories')}><span class="v" data-count={categoryCount}>{pad(categoryCount)}</span><span class="k">Categories</span></a>
        <a href={url('/tags')}><span class="v" data-count={tagCount}>{pad(tagCount)}</span><span class="k">Tags</span></a>
        <div><span class="v">{SITE.since.slice(0, 4)}</span><span class="k">Since</span></div>
      </div>
      <p class="hud mono" id="hud" hidden>
        <span><b id="hud-count">0</b> particles</span>
        <span>GPU physics</span>
        <span><b id="hud-fps">60</b> fps</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - var(--header-h));
    isolation: isolate;
  }
  /* 背景点阵：只在雕塑那一侧淡淡地露出来 */
  .dots {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: radial-gradient(circle, var(--line-2) 1px, transparent 1.4px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 50% 60% at 74% 44%, #000 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 50% 60% at 74% 44%, #000 0%, transparent 100%);
  }
  /* 整屏画布：粒子可以飞出雕塑本身的范围，底部渐隐，不会在边界上被一刀切断 */
  #stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    cursor: grab;
    /* 竖直方向留给页面滚动，水平拖动才交给旋转 */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    mask-image: linear-gradient(#000 82%, transparent);
    -webkit-mask-image: linear-gradient(#000 82%, transparent);
  }
  #stage:global(.dragging) {
    cursor: grabbing;
  }
  /* 文字浮在画布上面：空白处的指针事件要漏下去给画布，文字和按钮自己接 */
  .inner {
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .text > *,
  .foot > *,
  figcaption {
    pointer-events: auto;
  }
  .grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3rem;
    align-items: center;
    padding: 3.5rem 0 2.5rem;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    width: fit-content;
  }
  .eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .name {
    width: fit-content;
    margin: 1.4rem 0 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(4.4rem, 15.5vw, 10.5rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .name em {
    color: var(--accent);
    letter-spacing: -0.02em;
    /* 斜体数字和前面的正体字母之间留一点呼吸 */
    margin-left: 0.05em;
  }
  /* 逐字入场：从模糊、下沉的状态一个个对上焦 */
  .ch {
    display: inline-block;
    animation: focus-in 1.1s var(--ease) both;
    animation-delay: calc(var(--i) * 0.06s + 0.05s);
  }
  @keyframes focus-in {
    from {
      opacity: 0;
      filter: blur(16px);
      transform: translateY(0.18em) scale(1.06);
    }
  }
  .lead {
    width: fit-content;
    max-width: 30rem;
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--fg-2);
    text-wrap: pretty;
  }
  /* 单行 + 省略号：标语长短不一，不能让它换行把下面的内容顶上顶下 */
  .typer {
    display: flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    margin: 1.1rem 0 0;
    height: 1.8em;
    font-size: 0.88rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .typed {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .caret {
    flex: none;
  }
  .prompt {
    flex: none;
    color: var(--accent);
    margin-right: 0.7rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: fit-content;
    margin-top: 2.4rem;
  }

  /* ---------- 雕塑的占位格 ---------- */
  .art {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin: 0 auto;
    min-width: 0;
  }
  .art :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
    pointer-events: auto;
  }
  figcaption {
    position: absolute;
    inset: auto 0 -0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.1rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .cap-name {
    color: var(--fg-2);
  }
  .cap-next {
    margin-left: auto;
    padding: 0;
    border: none;
    background: none;
    color: var(--fg-2);
    font: inherit;
    cursor: pointer;
    transition: color 0.2s;
  }
  .cap-next span {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }
  .cap-next:hover {
    color: var(--accent);
  }
  .cap-next:hover span {
    transform: translateX(3px);
  }

  /* ---------- 数字 + 实时读数 ---------- */
  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.4rem 0 2rem;
    border-top: 1px solid var(--line);
  }
  .stats {
    display: flex;
    gap: clamp(1.5rem, 5vw, 4.5rem);
  }
  .stats > * {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .v {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }
  .k {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stats a:hover .v {
    color: var(--accent);
  }
  .hud {
    display: flex;
    gap: 0.4rem 1.2rem;
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .hud[hidden] {
    display: none;
  }
  .hud span + span::before {
    content: '/';
    margin-right: 1.2rem;
    color: var(--line-2);
  }
  .hud b {
    font-weight: 500;
    color: var(--fg-2);
  }

  @media (max-width: 900px) {
    .dots {
      mask-image: radial-gradient(ellipse 80% 36% at 50% 62%, #000 0%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 36% at 50% 62%, #000 0%, transparent 100%);
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding-top: 3rem;
    }
    .art {
      max-width: 420px;
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
    }
  }
  @media (max-width: 520px) {
    .cap-note {
      display: none;
    }
    .stats {
      width: 100%;
      justify-content: space-between;
      gap: 1rem;
    }
    .hud {
      flex-wrap: wrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch {
      animation: none;
    }
  }
</style>

<script>
  import { createSculpture, type Sculpture } from '../scripts/particles';
  import { MODELS } from '../scripts/surfaces';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timers: number[] = [];
  let cleanup: (() => void) | null = null;
  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

  function typewriter(el: HTMLElement, lines: string[]) {
    if (lines.length < 2) return;
    let li = 0;
    let ci = lines[0].length;
    let deleting = true;
    const step = () => {
      if (deleting) {
        el.textContent = lines[li].slice(0, --ci);
        if (ci <= 0) {
          deleting = false;
          li = (li + 1) % lines.length;
        }
        later(step, 25);
      } else {
        el.textContent = lines[li].slice(0, ++ci);
        if (ci >= lines[li].length) {
          deleting = true;
          later(step, 2400);
        } else later(step, 45 + Math.random() * 55);
      }
    };
    later(step, 2400);
  }

  function countUp(el: HTMLElement) {
    const n = Number(el.dataset.count);
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / 1200);
      el.textContent = String(Math.round(n * (1 - Math.pow(1 - p, 3)))).padStart(2, '0');
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // ---------- 粒子雕塑 ----------
  async function sculpture() {
    const stage = document.getElementById('stage') as HTMLCanvasElement | null;
    const art = document.getElementById('art');
    if (!stage || !art) return;
    const $ = (id: string) => document.getElementById(id);

    const onModel = (i: number) => {
      const m = MODELS[i];
      $('model-name')!.textContent = m.name;
      $('model-note')!.textContent = m.note;
      $('model-idx')!.textContent = String(i + 1);
    };
    const layout = () => {
      const a = art.getBoundingClientRect();
      const c = stage.getBoundingClientRect();
      return { x: a.left + a.width / 2 - c.left, y: a.top + a.height / 2 - c.top, r: Math.min(a.width, a.height) * 0.56 };
    };
    // 小屏、低配设备少放一些粒子；引擎自己还会在掉帧时继续降
    const weak = innerWidth < 720 || (navigator.hardwareConcurrency ?? 8) <= 4;
    const fmt = new Intl.NumberFormat('en-US');

    let ctrl: Pick<Sculpture, 'next' | 'refresh' | 'setScroll' | 'destroy'> | null = createSculpture(stage, {
      count: weak ? 70_000 : 160_000,
      // 调试用：网址带 ?hq 时不做自适应降画质
      adaptive: !new URLSearchParams(location.search).has('hq'),
      layout,
      onModel,
      onStats: ({ fps, count }) => {
        $('hud-count')!.textContent = fmt.format(count);
        $('hud-fps')!.textContent = fps ? String(fps) : '—';
      },
    });
    if (ctrl) {
      $('hud')!.hidden = false;
    } else {
      // 没有 WebGL2：换成画在占位格里的 CPU 点刻版本
      stage.remove();
      const canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      art.prepend(canvas);
      const { createStipple } = await import('../scripts/stipple');
      ctrl = createStipple(canvas, { onModel });
    }
    if (!ctrl) return;
    const c = ctrl;

    const nextBtn = $('model-next');
    nextBtn?.addEventListener('click', c.next);
    // 往下滚的时候把雕塑吹散
    const hero = document.getElementById('hero')!;
    const onScroll = () => c.setScroll((scrollY - hero.offsetHeight * 0.12) / (hero.offsetHeight * 0.75));
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    // 切换明暗主题、字体加载完导致布局变化后，重新取色和定位
    const themeWatch = new MutationObserver(c.refresh);
    themeWatch.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    const sizeWatch = new ResizeObserver(c.refresh);
    sizeWatch.observe(art);
    document.addEventListener('sculpture:next', c.next);

    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('sculpture:next', c.next);
      themeWatch.disconnect();
      sizeWatch.disconnect();
      c.destroy();
    };
  }

  function init() {
    sculpture();
    const typed = document.getElementById('typed');
    if (!typed || reduce) return;
    typewriter(typed, JSON.parse(typed.dataset.lines || '[]'));
    document.querySelectorAll<HTMLElement>('.stats .v[data-count]').forEach(countUp);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    timers.forEach(clearTimeout);
    timers = [];
    cleanup?.();
    cleanup = null;
  });
</script>

---
import { SITE } from '../config';
import { url } from '../utils/url';

interface Props {
  postCount: number;
  categoryCount: number;
  tagCount: number;
}
const { postCount, categoryCount, tagCount } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero container" id="hero">
  <div class="grid">
    <div class="text">
      <p class="label" data-reveal>{SITE.subtitle}</p>
      <h1 class="name mono" data-reveal style="--delay:.05s">
        <span data-scramble data-scramble-load>{SITE.author}</span>
      </h1>
      <p class="typer mono" data-reveal style="--delay:.1s">
        <span class="prompt">$</span>
        <span id="typed" data-lines={JSON.stringify(SITE.taglines)}>{SITE.taglines[0]}</span><span class="caret"></span>
      </p>
      <p class="lead" data-reveal style="--delay:.15s">{SITE.description}</p>
      <div class="cta" data-reveal style="--delay:.2s">
        <a class="btn btn-primary" href="#latest">开始阅读 ↓</a>
        <a class="btn" href={url('/archive')}>归档</a>
      </div>
    </div>

    <figure class="art" data-reveal style="--delay:.15s">
      <pre id="donut" aria-hidden="true"></pre>
      <figcaption class="label">fig.1 — 浏览器里实时渲染的 ASCII 圆环，鼠标悬停可以控制旋转</figcaption>
    </figure>
  </div>

  <dl class="stats mono" data-reveal style="--delay:.25s">
    <a href={url('/archive')}><dt>Writeups</dt><dd data-count={postCount}>{pad(postCount)}</dd></a>
    <a href={url('/categories')}><dt>Categories</dt><dd data-count={categoryCount}>{pad(categoryCount)}</dd></a>
    <a href={url('/tags')}><dt>Tags</dt><dd data-count={tagCount}>{pad(tagCount)}</dd></a>
    <div><dt>Since</dt><dd>{SITE.since.slice(0, 4)}</dd></div>
  </dl>
</section>

<style>
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem;
    align-items: center;
  }
  .name {
    margin: 0.6rem 0 1.2rem;
    font-size: clamp(3.2rem, 11vw, 7.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }
  .typer {
    margin: 0;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    min-height: 1.8em;
  }
  .prompt {
    color: var(--muted);
    margin-right: 0.6rem;
  }
  .lead {
    max-width: 460px;
    margin: 1.2rem 0 2rem;
    color: var(--fg-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .art {
    margin: 0;
    border: 1px solid var(--line);
    padding: 1rem 1rem 0.8rem;
  }
  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.1;
    color: var(--fg);
    white-space: pre;
    overflow: hidden;
    user-select: none;
    cursor: grab;
    text-align: center;
  }
  figcaption {
    margin-top: 0.8rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 4rem 0 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
  }
  .stats > * {
    padding: 1rem 1rem 1.1rem;
    border-left: 1px solid var(--line);
    transition: background 0.12s, color 0.12s;
  }
  .stats > :first-child {
    border-left: none;
    padding-left: 0;
  }
  .stats a:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .stats a:first-child:hover {
    padding-left: 1rem;
  }
  dt {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  dd {
    margin: 0.3rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 3rem;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats > :nth-child(3) {
      border-left: none;
      padding-left: 0;
    }
    .stats > :nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .stats a:nth-child(3):hover {
      padding-left: 1rem;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timers: number[] = [];
  let stopDonut: (() => void) | null = null;
  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

  function typewriter(el: HTMLElement, lines: string[]) {
    let li = 0;
    let ci = lines[0].length;
    let deleting = true;
    const step = () => {
      if (deleting) {
        el.textContent = lines[li].slice(0, --ci);
        if (ci <= 0) {
          deleting = false;
          li = (li + 1) % lines.length;
        }
        later(step, 25);
      } else {
        el.textContent = lines[li].slice(0, ++ci);
        if (ci >= lines[li].length) {
          deleting = true;
          later(step, 2400);
        } else later(step, 45 + Math.random() * 55);
      }
    };
    later(step, 2400);
  }

  function countUp(el: HTMLElement) {
    const n = Number(el.dataset.count);
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / 1200);
      el.textContent = String(Math.round(n * (1 - Math.pow(1 - p, 3)))).padStart(2, '0');
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // 经典的 ASCII 圆环（思路来自 a1k0n 的 donut.c）：
  // 对圆环表面采样 → 投影到字符网格 → 用 z-buffer 取最近的点 → 按光照亮度选字符
  function donut(pre: HTMLElement) {
    const CHARS = '.,-~:;=!*#$@';
    const COLS = 64;
    const ROWS = 34;
    const R1 = 1;
    const R2 = 2;
    const K2 = 5;
    const K1 = (COLS * K2 * 3) / (8 * (R1 + R2));
    const ASPECT = 0.55; // 字符宽 0.6em、行高 1.1em，纵向要压缩才是圆的

    const BASE_VA = 0.035;
    const BASE_VB = 0.018;
    let A = 1.0;
    let B = 0.6;
    let vA = BASE_VA;
    let vB = BASE_VB;
    let tA = BASE_VA;
    let tB = BASE_VB;
    let raf = 0;
    let visible = true;

    const fit = () => {
      const w = pre.clientWidth;
      pre.style.fontSize = `${Math.max(6, w / (COLS * 0.6))}px`;
    };

    const render = () => {
      const out = new Array(COLS * ROWS).fill(' ');
      const zbuf = new Float32Array(COLS * ROWS);
      const cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
      for (let t = 0; t < 6.283; t += 0.07) {
        const ct = Math.cos(t), st = Math.sin(t);
        for (let p = 0; p < 6.283; p += 0.02) {
          const cp = Math.cos(p), sp = Math.sin(p);
          const cx = R2 + R1 * ct;
          const cy = R1 * st;
          const x = cx * (cB * cp + sA * sB * sp) - cy * cA * sB;
          const y = cx * (sB * cp - sA * cB * sp) + cy * cA * cB;
          const ooz = 1 / (K2 + cA * cx * sp + cy * sA);
          const xp = Math.floor(COLS / 2 + K1 * ooz * x);
          const yp = Math.floor(ROWS / 2 - K1 * ASPECT * ooz * y);
          if (xp < 0 || xp >= COLS || yp < 0 || yp >= ROWS) continue;
          const L = cp * ct * sB - cA * ct * sp - sA * st + cB * (cA * st - ct * sA * sp);
          const i = xp + yp * COLS;
          if (L > 0 && ooz > zbuf[i]) {
            zbuf[i] = ooz;
            out[i] = CHARS[Math.min(CHARS.length - 1, Math.floor(L * 8))];
          }
        }
      }
      let s = '';
      for (let r = 0; r < ROWS; r++) s += out.slice(r * COLS, (r + 1) * COLS).join('') + '\n';
      pre.textContent = s;
    };

    const loop = () => {
      vA += (tA - vA) * 0.06;
      vB += (tB - vB) * 0.06;
      A += vA;
      B += vB;
      render();
      if (visible && !document.hidden) raf = requestAnimationFrame(loop);
    };

    // 鼠标相对中心的位置决定旋转方向和速度
    const onMove = (e: PointerEvent) => {
      const r = pre.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      tA = ny * 0.25;
      tB = nx * 0.25;
    };
    const onLeave = () => {
      tA = BASE_VA;
      tB = BASE_VB;
    };

    fit();
    render();
    if (reduce) return () => {};

    pre.addEventListener('pointermove', onMove);
    pre.addEventListener('pointerleave', onLeave);
    window.addEventListener('resize', fit);
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible) raf = requestAnimationFrame(loop);
    });
    io.observe(pre);
    const onVis = () => {
      cancelAnimationFrame(raf);
      if (!document.hidden && visible) raf = requestAnimationFrame(loop);
    };
    document.addEventListener('visibilitychange', onVis);

    return () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      window.removeEventListener('resize', fit);
      document.removeEventListener('visibilitychange', onVis);
    };
  }

  function init() {
    const pre = document.getElementById('donut');
    if (pre) stopDonut = donut(pre);
    const typed = document.getElementById('typed');
    if (!typed || reduce) return;
    typewriter(typed, JSON.parse(typed.dataset.lines || '[]'));
    document.querySelectorAll<HTMLElement>('.stats dd[data-count]').forEach(countUp);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    timers.forEach(clearTimeout);
    timers = [];
    stopDonut?.();
    stopDonut = null;
  });
</script>

---
import { SITE } from '../config';
import { url } from '../utils/url';

interface Props {
  postCount: number;
  categoryCount: number;
  tagCount: number;
}
const { postCount, categoryCount, tagCount } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero container" id="hero">
  <div class="grid">
    <div class="text">
      <p class="label" data-reveal>{SITE.subtitle}</p>
      <h1 class="name mono" data-reveal style="--delay:.05s">
        <span data-scramble data-scramble-load>{SITE.author}</span>
      </h1>
      <p class="typer mono" data-reveal style="--delay:.1s">
        <span class="prompt" aria-hidden="true">$</span>
        <span class="typed" id="typed" data-lines={JSON.stringify(SITE.taglines)}>{SITE.taglines[0]}</span><span
          class="caret"
          aria-hidden="true"></span>
      </p>
      <p class="lead" data-reveal style="--delay:.15s">{SITE.description}</p>
      <div class="cta" data-reveal style="--delay:.2s">
        <a class="btn btn-primary" href="#latest">开始阅读 ↓</a>
        <a class="btn" href={url('/archive')}>归档</a>
      </div>
    </div>

    <figure class="art" data-reveal style="--delay:.15s">
      <span class="tick tl" aria-hidden="true"></span>
      <span class="tick tr" aria-hidden="true"></span>
      <span class="tick bl" aria-hidden="true"></span>
      <span class="tick br" aria-hidden="true"></span>
      <pre id="model" aria-hidden="true"></pre>
      <figcaption class="mono">
        <span class="cap-name">fig.1 — <span id="model-name" aria-live="polite">trefoil knot</span></span>
        <button type="button" class="cap-next" id="model-next" aria-label="切换到下一个模型">
          <span id="model-idx">01/04</span> next →
        </button>
        <span class="cap-note" id="model-note">crossing number = 3</span>
        <span class="cap-hint">拖动旋转 · 点击切换</span>
      </figcaption>
    </figure>
  </div>

  <div class="stats mono" data-reveal style="--delay:.25s">
    <a href={url('/archive')}><span class="k">Writeups</span><span class="v" data-count={postCount}>{pad(postCount)}</span></a>
    <a href={url('/categories')}><span class="k">Categories</span><span class="v" data-count={categoryCount}>{pad(categoryCount)}</span></a>
    <a href={url('/tags')}><span class="k">Tags</span><span class="v" data-count={tagCount}>{pad(tagCount)}</span></a>
    <div><span class="k">Since</span><span class="v">{SITE.since.slice(0, 4)}</span></div>
  </div>
</section>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 4.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 4rem;
    align-items: center;
  }
  .name {
    margin: 0.8rem 0 1.4rem;
    font-size: clamp(3rem, 10.5vw, 7.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.065em;
    white-space: nowrap;
  }
  /* 单行 + 省略号：标语长短不一，不能让它换行把下面的内容顶上顶下 */
  .typer {
    display: flex;
    align-items: center;
    margin: 0;
    height: 1.8em;
    font-size: clamp(0.85rem, 2vw, 1.1rem);
    white-space: nowrap;
  }
  .typed {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .caret {
    flex: none;
  }
  .prompt {
    flex: none;
    color: var(--muted);
    margin-right: 0.6rem;
  }
  .lead {
    max-width: 460px;
    margin: 1.4rem 0 2.2rem;
    color: var(--fg-2);
    text-wrap: pretty;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ---------- 图：四角裁切标记，像印刷品上的插图 ---------- */
  .art {
    position: relative;
    margin: 0;
    padding: 1.4rem 1.4rem 1rem;
  }
  .tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--fg);
    border-style: solid;
    border-width: 0;
  }
  .tl {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .tr {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .br {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.1;
    color: var(--fg);
    white-space: pre;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    text-align: center;
    cursor: grab;
    /* 竖直方向留给页面滚动，水平拖动才交给旋转 */
    touch-action: pan-y;
  }
  pre.dragging {
    cursor: grabbing;
  }
  figcaption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    margin-top: 1rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--line-2);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .cap-name {
    color: var(--fg-2);
  }
  .cap-next {
    justify-self: end;
    padding: 0;
    border: none;
    background: none;
    color: var(--fg-2);
    font: inherit;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .cap-next:hover {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cap-hint {
    justify-self: end;
  }

  /* ---------- 数字条 ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 4.5rem 0 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
  }
  .stats > * {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.1rem;
    border-left: 1px solid var(--line);
    transition: background 0.12s, color 0.12s;
  }
  .stats > :first-child {
    border-left: none;
  }
  .stats a:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .k {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .v {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 3rem;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats > :nth-child(3) {
      border-left: none;
    }
    .stats > :nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let timers: number[] = [];
  let stopFigure: (() => void) | null = null;
  const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

  function typewriter(el: HTMLElement, lines: string[]) {
    let li = 0;
    let ci = lines[0].length;
    let deleting = true;
    const step = () => {
      if (deleting) {
        el.textContent = lines[li].slice(0, --ci);
        if (ci <= 0) {
          deleting = false;
          li = (li + 1) % lines.length;
        }
        later(step, 25);
      } else {
        el.textContent = lines[li].slice(0, ++ci);
        if (ci >= lines[li].length) {
          deleting = true;
          later(step, 2400);
        } else later(step, 45 + Math.random() * 55);
      }
    };
    later(step, 2400);
  }

  function countUp(el: HTMLElement) {
    const n = Number(el.dataset.count);
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / 1200);
      el.textContent = String(Math.round(n * (1 - Math.pow(1 - p, 3)))).padStart(2, '0');
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  // ---------- ASCII 曲面渲染 ----------
  // 每个模型是一个参数曲面 f(u, v)，u、v ∈ [0, 1]。预先在 U×V 网格上采样出点和法线，
  // 每帧旋转 → 透视投影到字符网格 → z-buffer 取最近的点 → 按光照亮度选字符。
  // 所有模型共用同一套网格，所以切换时可以逐点插值，形状会“变形”过去。
  type Vec = [number, number, number];
  // 约定：模型的对称轴是 y 轴，展示时绕它转（转台），tilt 是默认的俯视角
  type Model = { name: string; note: string; tilt: number; f: (u: number, v: number) => Vec };

  const TAU = Math.PI * 2;
  const U = 720;
  const V = 72;
  const N = U * V;

  const sub = (a: Vec, b: Vec): Vec => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
  const cross = (a: Vec, b: Vec): Vec => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
  const unit = (a: Vec): Vec => {
    const l = Math.hypot(a[0], a[1], a[2]) || 1;
    return [a[0] / l, a[1] / l, a[2] / l];
  };

  // 沿空间曲线 c(t) 包一根半径为 r 的管子（Frenet 标架）
  const tube = (c: (t: number) => Vec, r: number) => (u: number, v: number): Vec => {
    const t = u * TAU;
    const e = 1e-3;
    const p = c(t), a = c(t - e), b = c(t + e);
    const T = unit(sub(b, a));
    const B = unit(cross(T, [a[0] + b[0] - 2 * p[0], a[1] + b[1] - 2 * p[1], a[2] + b[2] - 2 * p[2]]));
    const Nn = cross(B, T);
    const cp = Math.cos(v * TAU) * r, sp = Math.sin(v * TAU) * r;
    return [p[0] + cp * Nn[0] + sp * B[0], p[1] + cp * Nn[1] + sp * B[1], p[2] + cp * Nn[2] + sp * B[2]];
  };

  const ring = (p: (c: number, s: number) => Vec) => tube((t) => p(Math.cos(t), Math.sin(t)), 0.13);
  const BORROMEAN = [
    ring((c, s) => [c, s * 0.55, 0]),
    ring((c, s) => [0, c, s * 0.55]),
    ring((c, s) => [s * 0.55, 0, c]),
  ];

  const MODELS: Model[] = [
    {
      name: 'trefoil knot',
      note: 'crossing number = 3',
      tilt: 1.0,
      // 写成 (2,3) 环面纽结：俯视是绕着中心孔的三瓣
      f: tube((t) => {
        const r = 2 + Math.cos(3 * t);
        return [r * Math.cos(2 * t), Math.sin(3 * t), r * Math.sin(2 * t)];
      }, 0.42),
    },
    {
      name: 'möbius strip',
      note: 'one side, one edge',
      tilt: 0.7,
      f: (u, v) => {
        const t = u * TAU;
        const s = (v - 0.5) * 0.8;
        const r = 1 + s * Math.cos(t / 2);
        return [r * Math.cos(t), s * Math.sin(t / 2), r * Math.sin(t)];
      },
    },
    {
      name: 'klein bottle',
      note: 'non-orientable, χ = 0',
      tilt: 0.25,
      f: (uu, vv) => {
        const u = uu * Math.PI, v = vv * TAU;
        const cu = Math.cos(u), su = Math.sin(u), cv = Math.cos(v), sv = Math.sin(v);
        const x = (-2 / 15) * cu * (3 * cv - 30 * su + 90 * cu ** 4 * su - 60 * cu ** 6 * su + 5 * cu * cv * su);
        const y =
          (-1 / 15) * su *
          (3 * cv - 3 * cu ** 2 * cv - 48 * cu ** 4 * cv + 48 * cu ** 6 * cv - 60 * su + 5 * cu * cv * su -
            5 * cu ** 3 * cv * su - 80 * cu ** 5 * cv * su + 80 * cu ** 7 * cv * su);
        const z = (2 / 15) * (3 + 5 * cu * su) * sv;
        return [x, y, z];
      },
    },
    {
      // 三个互相垂直的椭圆：整体扣在一起，但任意拿掉一个，剩下两个就散了
      name: 'borromean rings',
      note: 'no two rings are linked',
      tilt: 0.55,
      f: (u, v) => {
        const k = Math.min(2, Math.floor(u * 3));
        return BORROMEAN[k](u * 3 - k, v);
      },
    },
  ];

  type Geo = { P: Float32Array; Nn: Float32Array };
  const cache = new Map<number, Geo>();

  // 采样：位置居中并缩放到单位球内（双面光照，法线朝向无所谓）
  function geometry(i: number): Geo {
    const hit = cache.get(i);
    if (hit) return hit;
    const f = MODELS[i].f;
    const P = new Float32Array(N * 3);
    const lo = [Infinity, Infinity, Infinity], hi = [-Infinity, -Infinity, -Infinity];
    for (let a = 0; a < U; a++) {
      for (let b = 0; b < V; b++) {
        const p = f((a + 0.5) / U, b / (V - 1));
        const k = (a * V + b) * 3;
        for (let d = 0; d < 3; d++) {
          P[k + d] = p[d];
          lo[d] = Math.min(lo[d], p[d]);
          hi[d] = Math.max(hi[d], p[d]);
        }
      }
    }
    const mid = lo.map((l, d) => (l + hi[d]) / 2);
    let R = 0;
    for (let k = 0; k < N * 3; k += 3) {
      P[k] -= mid[0];
      P[k + 1] -= mid[1];
      P[k + 2] -= mid[2];
      R = Math.max(R, Math.hypot(P[k], P[k + 1], P[k + 2]));
    }
    for (let k = 0; k < N * 3; k++) P[k] /= R;

    // 法线直接在参数空间里取差分，接缝处、几段拼起来的模型也不会算错
    const Nn = new Float32Array(N * 3);
    const e = 1e-5;
    for (let a = 0; a < U; a++) {
      const u = (a + 0.5) / U;
      for (let b = 0; b < V; b++) {
        const w = b / (V - 1);
        const n = unit(cross(sub(f(u + e, w), f(u - e, w)), sub(f(u, w + e), f(u, w - e))));
        Nn.set(n, (a * V + b) * 3);
      }
    }
    const geo = { P, Nn };
    cache.set(i, geo);
    return geo;
  }

  function figure(pre: HTMLElement) {
    const CHARS = '.,-~:;=!*#$@';
    const COLS = 80;
    const ROWS = 42;
    const K2 = 4;
    const K1 = COLS * K2 * 0.44; // 单位球内的点投影后刚好不出界
    const ASPECT = 0.55; // 字符宽 0.6em、行高 1.1em，纵向要压缩才是圆的
    const LIGHT = unit([-0.5, 0.6, -0.65]); // 从观察者左上方打光
    const IDLE = -0.012; // 每帧自转的弧度
    const AUTO_NEXT = 15000;

    const nameEl = document.getElementById('model-name');
    const noteEl = document.getElementById('model-note');
    const idxEl = document.getElementById('model-idx');
    const nextBtn = document.getElementById('model-next');

    // 转台式旋转：M = Rx(tilt) · Ry(spin)，模型永远绕自己的对称轴转，不会翻到看不懂的角度
    let spin = 0.6;
    let tiltBase = MODELS[0].tilt;
    let tiltFrom = tiltBase;
    let tiltDrag = 0; // 竖直拖动带来的额外俯仰，松手后慢慢回弹
    const matrix = () => {
      const t = Math.max(-1.45, Math.min(1.45, tiltBase + tiltDrag));
      const cx = Math.cos(t), sx = Math.sin(t), cy = Math.cos(spin), sy = Math.sin(spin);
      return [cy, 0, sy, sx * sy, cx, -sx * cy, -cx * sy, sx, cx * cy];
    };

    let current = 0;
    const P = new Float32Array(N * 3);
    const Nn = new Float32Array(N * 3);
    let from: Geo | null = null;
    let to: Geo = geometry(0);
    let morph = 1;
    P.set(to.P);
    Nn.set(to.Nn);

    const out: string[] = new Array(COLS * ROWS);
    const zbuf = new Float32Array(COLS * ROWS);

    const render = () => {
      out.fill(' ');
      zbuf.fill(0);
      const [m0, m1, m2, m3, m4, m5, m6, m7, m8] = matrix();
      for (let k = 0; k < N * 3; k += 3) {
        const x0 = P[k], y0 = P[k + 1], z0 = P[k + 2];
        const z = m6 * x0 + m7 * y0 + m8 * z0;
        const ooz = 1 / (K2 + z);
        const xp = Math.floor(COLS / 2 + K1 * ooz * (m0 * x0 + m1 * y0 + m2 * z0));
        const yp = Math.floor(ROWS / 2 - K1 * ASPECT * ooz * (m3 * x0 + m4 * y0 + m5 * z0));
        if (xp < 0 || xp >= COLS || yp < 0 || yp >= ROWS) continue;
        const i = xp + yp * COLS;
        if (ooz <= zbuf[i]) continue;
        zbuf[i] = ooz;
        const a = Nn[k], b = Nn[k + 1], c = Nn[k + 2];
        let nx = m0 * a + m1 * b + m2 * c;
        let ny = m3 * a + m4 * b + m5 * c;
        let nz = m6 * a + m7 * b + m8 * c;
        if (nz > 0) {
          nx = -nx;
          ny = -ny;
          nz = -nz;
        }
        const len = Math.hypot(nx, ny, nz) || 1;
        const L = Math.max(0, (nx * LIGHT[0] + ny * LIGHT[1] + nz * LIGHT[2]) / len);
        out[i] = CHARS[Math.min(CHARS.length - 1, Math.floor(L * L * 0.4 * CHARS.length + L * 0.6 * CHARS.length))];
      }
      let s = '';
      for (let r = 0; r < ROWS; r++) s += out.slice(r * COLS, (r + 1) * COLS).join('') + '\n';
      pre.textContent = s;
    };

    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const stepMorph = (dt: number) => {
      if (!from) return;
      morph = Math.min(1, morph + dt / 75);
      const e = ease(morph);
      tiltBase = tiltFrom + (MODELS[current].tilt - tiltFrom) * e;
      const fP = from.P, tP = to.P, fN = from.Nn, tN = to.Nn;
      for (let k = 0; k < N * 3; k++) {
        P[k] = fP[k] + (tP[k] - fP[k]) * e;
        Nn[k] = fN[k] + (tN[k] - fN[k]) * e;
      }
      if (morph >= 1) from = null;
    };

    let lastInteraction = performance.now();
    const next = () => {
      current = (current + 1) % MODELS.length;
      const m = MODELS[current];
      if (nameEl) nameEl.textContent = m.name;
      if (noteEl) noteEl.textContent = m.note;
      if (idxEl) idxEl.textContent = `${String(current + 1).padStart(2, '0')}/${String(MODELS.length).padStart(2, '0')}`;
      // 从“当前画面”出发变形，切换途中再点也是连续的
      from = { P: P.slice(), Nn: Nn.slice() };
      tiltFrom = tiltBase;
      to = geometry(current);
      morph = 0;
      lastInteraction = performance.now();
      if (reduce) {
        stepMorph(Infinity);
        render();
      }
    };

    // ---------- 拖动：水平拨动转台（带惯性），竖直调俯仰（松手回弹）；点一下换模型 ----------
    let v = IDLE;
    let drag: { x: number; y: number; moved: number } | null = null;
    const perPx = () => Math.PI / Math.max(240, pre.clientWidth);

    const onDown = (e: PointerEvent) => {
      if (e.button !== 0) return;
      drag = { x: e.clientX, y: e.clientY, moved: 0 };
      pre.setPointerCapture(e.pointerId);
      pre.classList.add('dragging');
      v = 0;
      lastInteraction = performance.now();
    };
    const onMove = (e: PointerEvent) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      drag.x = e.clientX;
      drag.y = e.clientY;
      drag.moved += Math.abs(dx) + Math.abs(dy);
      const k = perPx();
      spin -= dx * k;
      tiltDrag = Math.max(-1.45 - tiltBase, Math.min(1.45 - tiltBase, tiltDrag - dy * k));
      v = v * 0.3 - dx * k * 0.7;
      lastInteraction = performance.now();
      if (reduce) render();
    };
    const onUp = (e: PointerEvent) => {
      if (!drag) return;
      const click = e.type === 'pointerup' && drag.moved < 6;
      drag = null;
      pre.classList.remove('dragging');
      v = Math.max(-0.25, Math.min(0.25, v));
      if (click) next();
    };

    const fit = () => {
      pre.style.fontSize = `${Math.max(6, pre.clientWidth / (COLS * 0.6))}px`;
    };

    let raf = 0;
    let visible = true;
    let last = performance.now();
    const loop = (now: number) => {
      const dt = Math.min(3, (now - last) / 16.667);
      last = now;
      if (!drag) {
        spin += v * dt;
        // 甩出去的速度慢慢回落到默认自转，俯仰在松手一会儿后回弹
        v += (IDLE - v) * (1 - Math.pow(0.97, dt));
        if (now - lastInteraction > 1200) tiltDrag *= Math.pow(0.96, dt);
        if (now - lastInteraction > AUTO_NEXT) next();
      } else {
        v *= Math.pow(0.7, dt);
      }
      stepMorph(dt);
      render();
      if (visible && !document.hidden) raf = requestAnimationFrame(loop);
    };
    const start = () => {
      cancelAnimationFrame(raf);
      if (visible && !document.hidden) {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      }
    };

    fit();
    render();
    // 其余模型趁空闲时预先算好，切换时就不会卡一下
    let alive = true;
    const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb) : setTimeout(cb, 300));
    const warm = (i: number) => {
      if (!alive || i >= MODELS.length) return;
      geometry(i);
      idle(() => warm(i + 1));
    };
    idle(() => warm(1));
    pre.addEventListener('pointerdown', onDown);
    pre.addEventListener('pointermove', onMove);
    pre.addEventListener('pointerup', onUp);
    pre.addEventListener('pointercancel', onUp);
    nextBtn?.addEventListener('click', next);
    window.addEventListener('resize', fit);
    if (reduce) {
      return () => {
        alive = false;
        window.removeEventListener('resize', fit);
      };
    }

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    });
    io.observe(pre);
    document.addEventListener('visibilitychange', start);

    return () => {
      alive = false;
      cancelAnimationFrame(raf);
      io.disconnect();
      window.removeEventListener('resize', fit);
      document.removeEventListener('visibilitychange', start);
    };
  }

  function init() {
    const pre = document.getElementById('model');
    if (pre) stopFigure = figure(pre);
    const typed = document.getElementById('typed');
    if (!typed || reduce) return;
    typewriter(typed, JSON.parse(typed.dataset.lines || '[]'));
    document.querySelectorAll<HTMLElement>('.stats .v[data-count]').forEach(countUp);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    timers.forEach(clearTimeout);
    timers = [];
    stopFigure?.();
    stopFigure = null;
  });
</script>

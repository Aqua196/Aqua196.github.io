---
import type { Post } from '../utils/posts';
import { categoryMeta, formatDate, readingStats } from '../utils/posts';
import { postUrl } from '../utils/url';
import Difficulty from './Difficulty.astro';

interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { title, description, category, tags, event, date, difficulty, pinned } = post.data;
const cat = categoryMeta(category);
const { minutes } = readingStats(post.body);
---

<li class="row" data-reveal style={`--delay:${Math.min(index, 10) * 0.04}s`}>
  <a href={postUrl(post.id)}>
    <time class="date mono" datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="cat mono">{cat.label}</span>
    <span class="main">
      <span class="title">
        {pinned && <span class="pin mono">[置顶]</span>}
        <span transition:name={`post-title-${post.id}`}>{title}</span>
      </span>
      {description && <span class="desc">{description}</span>}
      <span class="info mono">
        {event && <span>{event}</span>}
        {tags.slice(0, 4).map((t) => <span>#{t}</span>)}
      </span>
    </span>
    <span class="side mono">
      {difficulty && <Difficulty value={difficulty} />}
      <span>{minutes} min</span>
    </span>
    <span class="arrow mono" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .row {
    border-bottom: 1px solid var(--line);
  }
  a {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 6rem minmax(0, 1fr) auto 1.5rem;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.3rem 0.75rem;
    margin: 0 -0.75rem;
    transition: background 0.12s, color 0.12s;
  }
  a:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .date,
  .cat,
  .side {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cat {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .title {
    text-wrap: balance;
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.45;
  }
  .pin {
    font-size: 0.75rem;
    font-weight: 500;
    margin-right: 0.4rem;
  }
  .desc {
    font-size: 0.9rem;
    color: var(--fg-2);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    white-space: nowrap;
  }
  .arrow {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.15s, transform 0.2s var(--ease);
  }
  a:hover .arrow {
    opacity: 1;
    transform: none;
  }
  a:hover .date,
  a:hover .cat,
  a:hover .side,
  a:hover .desc,
  a:hover .info {
    color: inherit;
    opacity: 0.75;
  }

  @media (max-width: 720px) {
    a {
      grid-template-columns: auto auto 1fr;
      gap: 0.4rem 0.9rem;
      padding: 1.1rem 0.5rem;
      margin: 0 -0.5rem;
    }
    .main {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .side {
      flex-direction: row;
      gap: 0.9rem;
      justify-self: end;
    }
    .arrow {
      display: none;
    }
  }
</style>

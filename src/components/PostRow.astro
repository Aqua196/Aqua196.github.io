---
import type { Post } from '../utils/posts';
import { categoryMeta, formatDate, readingStats } from '../utils/posts';
import { postUrl } from '../utils/url';
import Difficulty from './Difficulty.astro';

interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { title, description, category, tags, event, date, difficulty, pinned } = post.data;
const cat = categoryMeta(category);
const { minutes } = readingStats(post.body);
---

<li class="row" data-reveal data-tone style={`--h:${cat.hue};--delay:${Math.min(index, 10) * 0.04}s`}>
  <a href={postUrl(post.id)}>
    <span class="when mono">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span class="chip">{cat.label}</span>
    </span>
    <span class="main">
      <span class="title">
        {pinned && <span class="pin mono">置顶</span>}
        <span transition:name={`post-title-${post.id}`}>{title}</span>
      </span>
      {description && <span class="desc">{description}</span>}
      {
        (event || tags.length > 0) && (
          <span class="info mono">
            {event && <span class="event">{event}</span>}
            {tags.slice(0, 4).map((t) => <span>#{t}</span>)}
          </span>
        )
      }
    </span>
    <span class="side mono">
      {difficulty && <Difficulty value={difficulty} />}
      <span>{minutes} min</span>
    </span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .row {
    border-bottom: 1px solid var(--line);
  }
  a {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto 1.25rem;
    gap: 2rem;
    align-items: start;
    padding: 1.6rem 1.25rem;
    margin: 0 -1.25rem;
    border-radius: var(--radius);
    transition: background 0.25s;
  }
  a:hover {
    background: var(--bg-2);
  }
  .when {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .title {
    text-wrap: balance;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }
  a:hover .title {
    color: var(--cat);
  }
  .pin {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.2em 0.6em;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    vertical-align: 0.2em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
  }
  .desc {
    max-width: 44rem;
    font-size: 0.93rem;
    color: var(--fg-2);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    margin-top: 0.25rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .event {
    color: var(--fg-2);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.55rem;
    padding-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .arrow {
    padding-top: 0.15rem;
    color: var(--cat);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.2s, transform 0.3s var(--ease);
  }
  a:hover .arrow {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 760px) {
    a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.7rem 1rem;
      padding: 1.25rem 0.75rem;
      margin: 0 -0.75rem;
    }
    .when {
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: center;
      gap: 0.9rem;
      padding-top: 0;
    }
    .main {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .side {
      flex-direction: row-reverse;
      align-items: center;
      gap: 0.8rem;
      padding-top: 0;
    }
    .arrow {
      display: none;
    }
  }
</style>

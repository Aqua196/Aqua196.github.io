---
import { NAV, SITE, SOCIALS } from '../config';
import { url } from '../utils/url';

// 命令面板里的固定条目：页面跳转在这里生成，需要跑脚本的动作（切主题、开终端…）由前端按 action 分发
const commands = [
  ...NAV.map((n) => ({ id: `go:${n.href}`, label: `前往 ${n.label}`, group: '跳转', keys: `${n.label} ${n.href} go`, href: url(n.href) })),
  { id: 'theme', label: '切换明暗主题', group: '操作', keys: 'theme dark light 主题 深色 浅色 夜间', action: 'theme' },
  { id: 'terminal', label: '打开终端', group: '操作', keys: 'terminal shell 终端 命令行', action: 'terminal', kbd: '`' },
  { id: 'random', label: '随机读一篇', group: '操作', keys: 'random 随机 lucky', action: 'random' },
  { id: 'sculpture', label: '换一个曲面（首页）', group: '操作', keys: 'next model surface 曲面 模型 粒子', action: 'sculpture' },
  { id: 'copy', label: '复制当前页链接', group: '操作', keys: 'copy link url 复制 链接', action: 'copy' },
  { id: 'colophon', label: '本站是怎么做的', group: '跳转', keys: 'colophon about site 技术 实现', href: url('/colophon') },
  { id: 'rss', label: 'RSS 订阅', group: '跳转', keys: 'rss feed 订阅', href: url('/rss.xml'), external: true },
  ...(SOCIALS.github ? [{ id: 'github', label: 'GitHub', group: '跳转', keys: 'github 代码 源码', href: SOCIALS.github, external: true }] : []),
];
---

<dialog id="search-dialog" class="search" aria-label="搜索与命令" data-index={url('/search.json')} data-commands={JSON.stringify(commands)} data-author={SITE.author}>
  <div class="panel">
    <div class="input-row">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input
        id="search-input"
        type="search"
        placeholder="搜索文章，或输入 > 执行命令…"
        aria-label="搜索文章或命令"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="search-results"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>ESC</kbd>
    </div>
    <ul id="search-results" class="results" role="listbox" aria-label="结果"></ul>
    <div class="foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>&gt;</kbd> 命令</span>
      <span class="count" id="search-count" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: min(660px, calc(100vw - 32px));
    max-height: min(620px, calc(100vh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--fg);
    overflow: visible;
  }
  .search::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .search[open] .panel {
    animation: palette-in 0.25s var(--ease);
  }
  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .input-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--fg);
    font-size: 1.05rem;
    font-family: var(--font-body);
  }
  input::placeholder {
    color: var(--muted);
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
  }
  .results :global(li a) {
    display: block;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
  }
  .results :global(li.active a) {
    background: var(--bg-3);
  }
  .results :global(.r-title) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .results :global(.r-title .chip) {
    flex: none;
  }
  .results :global(.r-snippet) {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .results :global(.r-group) {
    padding: 0.7rem 0.9rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .results :global(.r-cmd a) {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.95rem;
  }
  .results :global(.r-cmd .ico) {
    flex: none;
    width: 1.4rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .results :global(.r-cmd.active .ico) {
    color: var(--accent);
  }
  .results :global(.r-cmd kbd),
  .results :global(.r-cmd .ext) {
    margin-left: auto;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .results :global(mark) {
    background: transparent;
    color: var(--accent);
  }
  .results :global(.r-empty button) {
    margin-top: 0.9rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .results :global(.r-empty button:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .results :global(.r-empty) {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot {
    display: flex;
    gap: 1.1rem;
    padding: 0.65rem 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .foot kbd {
    margin-right: 3px;
  }
  .count {
    margin-left: auto;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  type Entry = {
    title: string;
    url: string;
    description: string;
    category: string;
    categoryLabel: string;
    hue: number;
    tags: string[];
    event: string;
    date: string;
    body: string;
  };
  type Prepared = Entry & { f: { title: string; meta: string; desc: string; body: string } };

  let index: Prepared[] | null = null;
  let loading: Promise<void> | null = null;
  let failed = false;
  let active = 0;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  /**
   * 搜索用的归一化：小写 + 去掉重音（Håstad → hastad）。
   * 逐字符处理并保持长度不变，这样在归一化文本里找到的位置可以直接用来高亮原文。
   */
  function fold(s: string) {
    let out = '';
    for (const ch of s) {
      const lower = ch.toLowerCase();
      const base = lower.normalize('NFKD').replace(/\p{M}/gu, '');
      if (base.length === ch.length) out += base;
      else if (lower.length === ch.length) out += lower;
      else out += ch;
    }
    return out;
  }

  const terms = (q: string) => fold(q).split(/\s+/).filter(Boolean);

  function highlight(text: string, ts: string[]) {
    if (!ts.length) return esc(text);
    const folded = fold(text);
    const ranges: [number, number][] = [];
    for (const t of ts) {
      for (let i = folded.indexOf(t); i >= 0; i = folded.indexOf(t, i + t.length)) ranges.push([i, i + t.length]);
    }
    ranges.sort((a, b) => a[0] - b[0]);
    let html = '';
    let pos = 0;
    for (const [a, b] of ranges) {
      if (a < pos) continue;
      html += esc(text.slice(pos, a)) + `<mark>${esc(text.slice(a, b))}</mark>`;
      pos = b;
    }
    return html + esc(text.slice(pos));
  }

  function snippet(e: Prepared, ts: string[]) {
    let pos = -1;
    for (const t of ts) {
      pos = e.f.body.indexOf(t);
      if (pos >= 0) break;
    }
    if (pos < 0) return e.body.slice(0, 90);
    const start = Math.max(0, pos - 30);
    return (start > 0 ? '…' : '') + e.body.slice(start, start + 110);
  }

  function search(q: string) {
    if (!index) return [];
    const ts = terms(q);
    if (!ts.length) return index.slice(0, 8).map((e) => ({ e, snip: e.description }));
    const out: { e: Prepared; score: number; snip: string }[] = [];
    for (const e of index) {
      let score = 0;
      for (const t of ts) {
        const s =
          (e.f.title.includes(t) ? 10 : 0) +
          (e.f.meta.includes(t) ? 6 : 0) +
          (e.f.desc.includes(t) ? 3 : 0) +
          (e.f.body.includes(t) ? 1 : 0);
        if (!s) {
          score = 0;
          break;
        }
        score += s;
      }
      if (!score) continue;
      const inBody = !e.f.title.includes(ts[0]) && !e.f.desc.includes(ts[0]);
      out.push({ e, score, snip: inBody ? snippet(e, ts) : e.description });
    }
    return out.sort((a, b) => b.score - a.score).slice(0, 20);
  }

  async function loadIndex(url: string) {
    try {
      const r = await fetch(url);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const data: Entry[] = await r.json();
      index = data.map((e) => ({
        ...e,
        f: {
          title: fold(e.title),
          meta: fold([e.category, e.categoryLabel, e.event, ...e.tags].join(' ')),
          desc: fold(e.description),
          body: fold(e.body),
        },
      }));
      failed = false;
    } catch {
      failed = true;
    }
  }

  function ensureIndex(dialog: HTMLDialogElement) {
    if (index) return;
    loading ??= loadIndex(dialog.dataset.index!).finally(() => {
      loading = null;
      render(dialog);
    });
  }

  // ---------- 命令 ----------
  type Cmd = { id: string; label: string; group: string; keys: string; href?: string; action?: string; external?: boolean; kbd?: string };
  let commands: (Cmd & { f: string })[] = [];

  function matchCommands(q: string) {
    const ts = terms(q.replace(/^>\s*/, ''));
    const here = commands.filter((c) => c.action !== 'sculpture' || document.getElementById('stage'));
    if (!ts.length) return here;
    return here.filter((c) => ts.every((t) => c.f.includes(t)));
  }

  function run(dialog: HTMLDialogElement, cmd: Cmd) {
    dialog.close();
    if (cmd.href) {
      if (cmd.external) window.open(cmd.href, '_blank', 'noopener');
      else navigate(cmd.href);
      return;
    }
    switch (cmd.action) {
      case 'theme':
        document.getElementById('theme-toggle')?.click();
        break;
      case 'terminal':
        document.dispatchEvent(new CustomEvent('terminal:open'));
        break;
      case 'sculpture':
        document.dispatchEvent(new CustomEvent('sculpture:next'));
        window.scrollTo({ top: 0, behavior: 'smooth' });
        break;
      case 'copy':
        navigator.clipboard?.writeText(location.href).catch(() => {});
        break;
      case 'random':
        if (index?.length) navigate(index[(Math.random() * index.length) | 0].url);
        break;
    }
  }

  // ---------- 渲染：命令和文章排在同一个列表里，上下键一路走到底 ----------
  type Item = { kind: 'cmd'; cmd: Cmd } | { kind: 'post'; e: Prepared; snip: string };
  let items: Item[] = [];

  function render(dialog: HTMLDialogElement) {
    const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
    const list = dialog.querySelector<HTMLUListElement>('#search-results')!;
    const count = dialog.querySelector<HTMLElement>('#search-count')!;
    const q = input.value.trim();
    const onlyCmd = q.startsWith('>');
    input.removeAttribute('aria-activedescendant');

    const cmds = matchCommands(q);
    const posts = onlyCmd || !index ? [] : search(q);
    // 没输入时命令在前（像个启动器）；开始搜索后文章在前
    const cmdItems: Item[] = (q && !onlyCmd ? cmds.slice(0, 4) : cmds).map((cmd) => ({ kind: 'cmd', cmd }));
    const postItems: Item[] = (q ? posts : posts.slice(0, 5)).map(({ e, snip }) => ({ kind: 'post', e, snip }));
    items = q && !onlyCmd ? [...postItems, ...cmdItems] : [...cmdItems, ...postItems];
    active = Math.min(active, Math.max(0, items.length - 1));
    const ts = terms(q.replace(/^>\s*/, ''));

    let html = '';
    let group = '';
    items.forEach((it, i) => {
      const g = it.kind === 'cmd' ? it.cmd.group : q ? '文章' : '最近文章';
      if (g !== group) html += `<li class="r-group" role="presentation">${(group = g)}</li>`;
      const sel = i === active;
      if (it.kind === 'cmd') {
        const c = it.cmd;
        const ico = c.href ? (c.external ? '↗' : '→') : '▸';
        const tail = c.kbd ? `<kbd>${esc(c.kbd)}</kbd>` : c.external ? '<span class="ext">新标签页</span>' : '';
        html += `<li id="search-opt-${i}" class="r-cmd${sel ? ' active' : ''}" role="option" aria-selected="${sel}" data-i="${i}">
          <a href="${c.href ?? '#'}" tabindex="-1"><span class="ico" aria-hidden="true">${ico}</span><span>${highlight(c.label, ts)}</span>${tail}</a></li>`;
      } else {
        const { e, snip } = it;
        html += `<li id="search-opt-${i}" class="${sel ? 'active' : ''}" role="option" aria-selected="${sel}" data-i="${i}">
          <a href="${e.url}" tabindex="-1">
            <div class="r-title"><span>${highlight(e.title, ts)}</span><span class="chip" data-tone style="--h:${e.hue}">${esc(e.categoryLabel)}</span></div>
            <div class="r-snippet">${highlight(snip, ts)}</div>
          </a></li>`;
      }
    });
    if (!index && !onlyCmd) {
      html += failed
        ? '<li class="r-empty">搜索索引加载失败<br/><button type="button" class="retry">重试</button></li>'
        : '<li class="r-empty">加载索引中…</li>';
    } else if (!items.length) {
      html = `<li class="r-empty">没有找到 “${esc(q)}”<br/>换个关键词试试？</li>`;
    }
    list.innerHTML = html;
    count.textContent = !index ? '' : q && !onlyCmd ? `${posts.length} 篇文章` : `共 ${index.length} 篇`;
    if (items.length) input.setAttribute('aria-activedescendant', `search-opt-${active}`);
    list.querySelector('li.active')?.scrollIntoView({ block: 'nearest' });
  }

  function open(prefill = '') {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dialog || dialog.open) return;
    dialog.showModal();
    const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
    if (prefill) input.value = prefill;
    input.select();
    if (prefill) input.setSelectionRange(prefill.length, prefill.length);
    active = 0;
    render(dialog);
    ensureIndex(dialog);
  }

  function choose(dialog: HTMLDialogElement, i: number) {
    const it = items[i];
    if (!it) return;
    if (it.kind === 'cmd') run(dialog, it.cmd);
    else {
      dialog.close();
      navigate(it.e.url);
    }
  }

  function init() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dialog) return;
    const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
    const list = dialog.querySelector<HTMLUListElement>('#search-results')!;
    commands = (JSON.parse(dialog.dataset.commands || '[]') as Cmd[]).map((c) => ({ ...c, f: fold(`${c.label} ${c.keys}`) }));

    document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', () => open()));
    input.addEventListener('input', () => {
      active = 0;
      render(dialog);
    });
    input.addEventListener('keydown', (e) => {
      const n = items.length;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!n) return;
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + n) % n;
        render(dialog);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        choose(dialog, active);
      }
    });
    list.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.retry')) {
        failed = false;
        render(dialog);
        ensureIndex(dialog);
        return;
      }
      const li = target.closest<HTMLElement>('li[data-i]');
      if (!li) return;
      e.preventDefault();
      choose(dialog, Number(li.dataset.i));
    });
    list.addEventListener('pointermove', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('li[data-i]');
      const i = li ? Number(li.dataset.i) : -1;
      if (i < 0 || i === active) return;
      list.querySelector('li.active')?.classList.remove('active');
      li!.classList.add('active');
      active = i;
    });
    // 点击遮罩关闭
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    const typing = el?.tagName === 'INPUT' || el?.tagName === 'TEXTAREA' || el?.isContentEditable;
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      open();
    } else if (!typing && !e.metaKey && !e.ctrlKey && !e.altKey && (e.key === '/' || e.key === '>')) {
      e.preventDefault();
      open(e.key === '>' ? '> ' : '');
    }
  });
  document.addEventListener('astro:page-load', init);
</script>

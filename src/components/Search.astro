---
import { url } from '../utils/url';
---

<dialog id="search-dialog" class="search" aria-label="搜索文章" data-index={url('/search.json')}>
  <div class="panel">
    <div class="input-row">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input
        id="search-input"
        type="search"
        placeholder="搜索标题、标签、正文、exp…"
        aria-label="搜索文章"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="search-results"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>ESC</kbd>
    </div>
    <ul id="search-results" class="results" role="listbox" aria-label="搜索结果"></ul>
    <div class="foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span class="count" id="search-count" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: min(660px, calc(100vw - 32px));
    max-height: min(620px, calc(100vh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--fg);
    overflow: visible;
  }
  .search::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .search[open] .panel {
    animation: pop 0.25s var(--ease);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .input-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--fg);
    font-size: 1.05rem;
    font-family: var(--font-body);
  }
  input::placeholder {
    color: var(--muted);
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
  }
  .results :global(li a) {
    display: block;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
  }
  .results :global(li.active a) {
    background: var(--bg-3);
  }
  .results :global(.r-title) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .results :global(.r-title .chip) {
    flex: none;
  }
  .results :global(.r-snippet) {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .results :global(mark) {
    background: transparent;
    color: var(--accent);
  }
  .results :global(.r-empty button) {
    margin-top: 0.9rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .results :global(.r-empty button:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .results :global(.r-empty) {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .foot {
    display: flex;
    gap: 1.1rem;
    padding: 0.65rem 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .foot kbd {
    margin-right: 3px;
  }
  .count {
    margin-left: auto;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  type Entry = {
    title: string;
    url: string;
    description: string;
    category: string;
    categoryLabel: string;
    hue: number;
    tags: string[];
    event: string;
    date: string;
    body: string;
  };
  type Prepared = Entry & { f: { title: string; meta: string; desc: string; body: string } };

  let index: Prepared[] | null = null;
  let loading: Promise<void> | null = null;
  let failed = false;
  let active = 0;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  /**
   * 搜索用的归一化：小写 + 去掉重音（Håstad → hastad）。
   * 逐字符处理并保持长度不变，这样在归一化文本里找到的位置可以直接用来高亮原文。
   */
  function fold(s: string) {
    let out = '';
    for (const ch of s) {
      const lower = ch.toLowerCase();
      const base = lower.normalize('NFKD').replace(/\p{M}/gu, '');
      if (base.length === ch.length) out += base;
      else if (lower.length === ch.length) out += lower;
      else out += ch;
    }
    return out;
  }

  const terms = (q: string) => fold(q).split(/\s+/).filter(Boolean);

  function highlight(text: string, ts: string[]) {
    if (!ts.length) return esc(text);
    const folded = fold(text);
    const ranges: [number, number][] = [];
    for (const t of ts) {
      for (let i = folded.indexOf(t); i >= 0; i = folded.indexOf(t, i + t.length)) ranges.push([i, i + t.length]);
    }
    ranges.sort((a, b) => a[0] - b[0]);
    let html = '';
    let pos = 0;
    for (const [a, b] of ranges) {
      if (a < pos) continue;
      html += esc(text.slice(pos, a)) + `<mark>${esc(text.slice(a, b))}</mark>`;
      pos = b;
    }
    return html + esc(text.slice(pos));
  }

  function snippet(e: Prepared, ts: string[]) {
    let pos = -1;
    for (const t of ts) {
      pos = e.f.body.indexOf(t);
      if (pos >= 0) break;
    }
    if (pos < 0) return e.body.slice(0, 90);
    const start = Math.max(0, pos - 30);
    return (start > 0 ? '…' : '') + e.body.slice(start, start + 110);
  }

  function search(q: string) {
    if (!index) return [];
    const ts = terms(q);
    if (!ts.length) return index.slice(0, 8).map((e) => ({ e, snip: e.description }));
    const out: { e: Prepared; score: number; snip: string }[] = [];
    for (const e of index) {
      let score = 0;
      for (const t of ts) {
        const s =
          (e.f.title.includes(t) ? 10 : 0) +
          (e.f.meta.includes(t) ? 6 : 0) +
          (e.f.desc.includes(t) ? 3 : 0) +
          (e.f.body.includes(t) ? 1 : 0);
        if (!s) {
          score = 0;
          break;
        }
        score += s;
      }
      if (!score) continue;
      const inBody = !e.f.title.includes(ts[0]) && !e.f.desc.includes(ts[0]);
      out.push({ e, score, snip: inBody ? snippet(e, ts) : e.description });
    }
    return out.sort((a, b) => b.score - a.score).slice(0, 20);
  }

  async function loadIndex(url: string) {
    try {
      const r = await fetch(url);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const data: Entry[] = await r.json();
      index = data.map((e) => ({
        ...e,
        f: {
          title: fold(e.title),
          meta: fold([e.category, e.categoryLabel, e.event, ...e.tags].join(' ')),
          desc: fold(e.description),
          body: fold(e.body),
        },
      }));
      failed = false;
    } catch {
      failed = true;
    }
  }

  function ensureIndex(dialog: HTMLDialogElement) {
    if (index) return;
    loading ??= loadIndex(dialog.dataset.index!).finally(() => {
      loading = null;
      render(dialog);
    });
  }

  function render(dialog: HTMLDialogElement) {
    const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
    const list = dialog.querySelector<HTMLUListElement>('#search-results')!;
    const count = dialog.querySelector<HTMLElement>('#search-count')!;
    const q = input.value.trim();
    input.removeAttribute('aria-activedescendant');

    if (!index) {
      count.textContent = '';
      list.innerHTML = failed
        ? '<li class="r-empty">搜索索引加载失败<br/><button type="button" class="retry">重试</button></li>'
        : '<li class="r-empty">加载索引中…</li>';
      return;
    }

    const res = search(q);
    active = Math.min(active, Math.max(0, res.length - 1));
    count.textContent = q ? `${res.length} 条结果` : `共 ${index.length} 篇`;
    if (!res.length) {
      list.innerHTML = q
        ? `<li class="r-empty">没有找到 “${esc(q)}”<br/>换个关键词试试？</li>`
        : '<li class="r-empty">还没有文章</li>';
      return;
    }
    const ts = terms(q);
    list.innerHTML = res
      .map(
        ({ e, snip }, i) => `
        <li id="search-opt-${i}" class="${i === active ? 'active' : ''}" role="option" aria-selected="${i === active}">
          <a href="${e.url}" tabindex="-1">
            <div class="r-title"><span>${highlight(e.title, ts)}</span><span class="chip" data-tone style="--h:${e.hue}">${esc(e.categoryLabel)}</span></div>
            <div class="r-snippet">${highlight(snip, ts)}</div>
          </a>
        </li>`,
      )
      .join('');
    input.setAttribute('aria-activedescendant', `search-opt-${active}`);
    list.querySelector('li.active')?.scrollIntoView({ block: 'nearest' });
  }

  function open() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dialog || dialog.open) return;
    dialog.showModal();
    dialog.querySelector<HTMLInputElement>('#search-input')!.select();
    active = 0;
    render(dialog);
    ensureIndex(dialog);
  }

  function go(dialog: HTMLDialogElement, href: string) {
    dialog.close();
    navigate(href);
  }

  function init() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dialog) return;
    const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
    const list = dialog.querySelector<HTMLUListElement>('#search-results')!;

    document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', open));
    input.addEventListener('input', () => {
      active = 0;
      render(dialog);
    });
    input.addEventListener('keydown', (e) => {
      const n = list.querySelectorAll('li[role=option]').length;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!n) return;
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + n) % n;
        render(dialog);
      } else if (e.key === 'Enter') {
        const a = list.querySelector<HTMLAnchorElement>('li.active a');
        if (a) {
          e.preventDefault();
          go(dialog, a.getAttribute('href')!);
        }
      }
    });
    list.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.retry')) {
        failed = false;
        render(dialog);
        ensureIndex(dialog);
        return;
      }
      const a = target.closest('a');
      if (!a) return;
      e.preventDefault();
      go(dialog, a.getAttribute('href')!);
    });
    // 点击遮罩关闭
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    const typing = el?.tagName === 'INPUT' || el?.tagName === 'TEXTAREA' || el?.isContentEditable;
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
  document.addEventListener('astro:page-load', init);
</script>

---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
---

<aside class="toc" aria-label="目录">
  <div class="label">On this page</div>
  <ol id="toc-list">
    {
      headings.map((h) => (
        <li class={`d${h.depth}`}>
          <a href={`#${h.slug}`} data-slug={h.slug}>
            {h.text}
          </a>
        </li>
      ))
    }
  </ol>
</aside>

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    max-height: calc(100vh - var(--header-h) - 64px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .label {
    margin-bottom: 0.9rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  li a {
    display: block;
    margin-left: -1px;
    padding: 0.32rem 0 0.32rem 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
    border-left: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  li.d3 a {
    padding-left: 1.9rem;
    font-size: 0.8rem;
  }
  li a:hover {
    color: var(--fg);
  }
  li a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  @media (max-width: 1100px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  function initToc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('#toc-list a')];
    if (!links.length) return;
    const heads = links
      .map((a) => document.getElementById(a.dataset.slug!))
      .filter((el): el is HTMLElement => !!el);

    const update = () => {
      let current = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top - 140 <= 0) current = h;
        else break;
      }
      links.forEach((a) => a.classList.toggle('active', a.dataset.slug === current?.id));
    };
    update();
    const onScroll = () => requestAnimationFrame(update);
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), {
      once: true,
    });
  }
  document.addEventListener('astro:page-load', initToc);
</script>

---
import Kinetic from '../components/Kinetic.astro';
import '../styles/prose.css';
import Base from './Base.astro';
import Socials from '../components/Socials.astro';
import { SITE, SOCIALS } from '../config';
import { url } from '../utils/url';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title ?? '关于'} description={frontmatter.description}>
  <div class="container about">
    <header class="page-head">
      <div class="eyebrow" data-reveal>cat ./about.md</div>
      <div class="who" data-reveal style="--delay:.05s">
        <div class="avatar" aria-hidden="true">
          {frontmatter.avatar ? <img src={url(frontmatter.avatar)} alt="" /> : SITE.author.slice(0, 1).toUpperCase()}
        </div>
        <div>
          <h1><Kinetic text={SITE.author} /></h1>
          <p>{frontmatter.bio ?? SITE.description}</p>
          <div class="links"><Socials socials={SOCIALS} inline /></div>
        </div>
      </div>
    </header>
    <div class="prose" data-reveal style="--delay:.1s">
      <slot />
    </div>
  </div>
</Base>

<style>
  .about > * {
    max-width: 820px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 128px;
    height: 128px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 5rem;
    line-height: 1;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 50%;
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .who h1 {
    font-size: clamp(2.8rem, 8vw, 4.6rem);
    margin-bottom: 0.7rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .links :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .links :global(a:hover) {
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
    }
    .avatar {
      width: 96px;
      height: 96px;
      font-size: 3.8rem;
    }
  }
</style>

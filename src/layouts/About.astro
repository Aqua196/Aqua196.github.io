---
import '../styles/prose.css';
import Base from './Base.astro';
import Socials from '../components/Socials.astro';
import { SITE, SOCIALS } from '../config';
import { url } from '../utils/url';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title ?? '关于'} description={frontmatter.description}>
  <div class="container about">
    <header class="page-head">
      <div class="eyebrow" data-reveal>$ cat ./about.md</div>
      <div class="who" data-reveal style="--delay:.05s">
        <div class="avatar mono" aria-hidden="true">
          {frontmatter.avatar ? <img src={url(frontmatter.avatar)} alt="" /> : SITE.author.slice(0, 1).toUpperCase()}
        </div>
        <div>
          <h1><span data-scramble data-scramble-load>{SITE.author}</span></h1>
          <p>{frontmatter.bio ?? SITE.description}</p>
          <div class="links mono"><Socials socials={SOCIALS} /></div>
        </div>
      </div>
    </header>
    <div class="prose" data-reveal style="--delay:.1s">
      <slot />
    </div>
  </div>
</Base>

<style>
  .about {
    max-width: 880px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    font-size: 3rem;
    font-weight: 800;
    background: var(--fg);
    color: var(--bg);
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }
  .who h1 {
    margin-bottom: 0.5rem;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.8rem;
    font-size: 0.8rem;
  }
  @media (max-width: 600px) {
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.2rem;
    }
  }
</style>

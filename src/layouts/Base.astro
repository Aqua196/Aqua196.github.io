---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { SITE } from '../config';
import { url } from '../utils/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import BackToTop from '../components/BackToTop.astro';
import Terminal from '../components/Terminal.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** 文章的发布 / 更新时间，用于分享卡片 */
  published?: Date;
  modified?: Date;
  /** 不让搜索引擎收录（404 页） */
  noindex?: boolean;
}

const { title, description = SITE.description, type = 'website', published, modified, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 分享卡片用的图：public/og.png（1200×630）
const ogImage = new URL(url('/og.png'), Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0a0c0f" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.lang.replace('-', '_')} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />

    <!-- 在首帧渲染前应用主题，避免闪烁：优先用户选择，其次跟随系统 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function apply() {
          var t = null;
          try {
            t = localStorage.getItem('theme');
          } catch (e) {}
          if (t !== 'light' && t !== 'dark') {
            t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          root.dataset.theme = t;
          root.classList.add('js');
          syncThemeColor();
        }
        // 浏览器地址栏颜色跟着当前主题走（包括手动切换的情况）
        function syncThemeColor() {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', root.dataset.theme === 'light' ? '#f7f7f3' : '#0a0c0f');
        }
        apply();
        if (!window.__themeHooked) {
          window.__themeHooked = true;
          document.addEventListener('astro:after-swap', apply);
          new MutationObserver(syncThemeColor).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
        }
      })();
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Search />
    <Terminal />
    <BackToTop />
    <p class="sr-only" id="copy-status" aria-live="polite"></p>
  </body>
</html>

<script>
  import '../scripts/fx';

  // ---------- 滚动出现 ----------
  function initReveal() {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
    if (!('IntersectionObserver' in window)) return els.forEach((el) => el.classList.add('is-visible'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
    );
    els.forEach((el) => io.observe(el));
  }

  // ---------- 乱码解密效果：[data-scramble] 的元素在加载和鼠标经过时播放 ----------
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const GLYPHS = '!<>-_\\/[]{}=+*^?#$%&01';
  const running = new WeakSet<HTMLElement>();

  function scramble(el: HTMLElement) {
    if (reduce || running.has(el)) return;
    const target = (el.dataset.text ??= el.textContent ?? '');
    running.add(el);
    let frame = 0;
    const total = target.length * 3;
    const tick = () => {
      el.textContent = [...target]
        .map((ch, i) => (ch === ' ' || i < frame / 3 ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0]))
        .join('');
      if (++frame <= total) setTimeout(tick, 28);
      else {
        el.textContent = target;
        running.delete(el);
      }
    };
    tick();
  }

  document.addEventListener('pointerover', (e) => {
    const el = (e.target as HTMLElement).closest?.<HTMLElement>('[data-scramble]');
    if (el && !el.contains(e.relatedTarget as Node)) scramble(el);
  });

  document.addEventListener('astro:page-load', () => {
    initReveal();
    document.querySelectorAll<HTMLElement>('[data-scramble-load]').forEach(scramble);
  });

  // ---------- 行内打码：让键盘和读屏也能用 ----------
  function initSpoilers() {
    document.querySelectorAll<HTMLElement>('.spoiler:not(.revealed)').forEach((el) => {
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.setAttribute('aria-label', '被隐藏的内容，按回车显示');
    });
  }
  function reveal(el: HTMLElement) {
    el.classList.add('revealed');
    el.removeAttribute('role');
    el.removeAttribute('tabindex');
    el.removeAttribute('aria-label');
  }
  document.addEventListener('astro:page-load', initSpoilers);
  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if ((e.key === 'Enter' || e.key === ' ') && el.classList?.contains('spoiler') && !el.classList.contains('revealed')) {
      e.preventDefault();
      reveal(el);
    }
  });

  // ---------- 图片放大：用 <dialog>，自带 Esc 关闭和焦点管理 ----------
  // 支持 View Transitions 的浏览器里，小图和大图共用一个 transition name，
  // 浏览器会把图片从正文里的位置补间到全屏（关闭时再补间回去），不用自己算 FLIP。
  function zoom(from: HTMLElement, to: HTMLElement, change: () => void) {
    const root = document.documentElement;
    if (!document.startViewTransition || reduce) return change();
    from.style.viewTransitionName = 'zoom';
    root.classList.add('zoom-transition');
    const t = document.startViewTransition(() => {
      from.style.viewTransitionName = '';
      change();
      to.style.viewTransitionName = 'zoom';
    });
    t.finished.finally(() => {
      to.style.viewTransitionName = '';
      root.classList.remove('zoom-transition');
    });
  }

  function openLightbox(img: HTMLImageElement) {
    const box = document.createElement('dialog');
    box.className = 'lightbox';
    box.setAttribute('aria-label', img.alt || '图片');
    const big = document.createElement('img');
    big.src = img.currentSrc || img.src;
    big.alt = img.alt;
    box.append(big);
    document.body.append(box);
    let closing = false;
    const shut = () => {
      if (closing) return;
      closing = true;
      zoom(big, img, () => {
        document.documentElement.classList.remove('lightbox-open');
        box.remove();
      });
    };
    box.addEventListener('click', shut);
    // Esc：拦下默认的立即关闭，改成带动画的关闭
    box.addEventListener('cancel', (e) => {
      e.preventDefault();
      shut();
    });
    zoom(img, big, () => {
      document.documentElement.classList.add('lightbox-open');
      box.showModal();
    });
  }

  // ---------- 给打开 DevTools 的同行留句话 ----------
  if (!(window as any).__greeted) {
    (window as any).__greeted = true;
    const mono = 'font-family: ui-monospace, Menlo, Consolas, monospace;';
    console.log(
      `%c   .-""""-.\n  /        \\\n |~~~~~~~~~~|\n |  ~~~~~~  |\n  \\        /\n   '-....-'\n%c你好，同行。%c\n这个站没有用 UI 框架和动画库，实现思路都写在 /colophon 里。\n按 \` 可以打开一个终端——里面藏了一个 flag。`,
      `${mono} color: #62e0d1; line-height: 1.2;`,
      'font-size: 15px; font-weight: 600; line-height: 2.2;',
      `${mono} color: inherit;`,
    );
  }

  // ---------- 代码复制 / 打码揭示 / 图片放大 ----------
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const copyBtn = target.closest<HTMLButtonElement>('.code-copy');
    if (copyBtn) {
      const code = copyBtn.closest('.code-window')?.querySelector('pre code') as HTMLElement | null;
      if (!code) return;
      const text = [...code.querySelectorAll('.line')].map((l) => l.textContent).join('\n') || code.innerText;
      const status = document.getElementById('copy-status');
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = 'copied';
        if (status) status.textContent = '代码已复制';
      } catch {
        copyBtn.textContent = 'failed';
        if (status) status.textContent = '复制失败';
      }
      setTimeout(() => {
        copyBtn.textContent = 'copy';
        if (status) status.textContent = '';
      }, 1500);
      return;
    }

    const spoiler = target.closest<HTMLElement>('.spoiler');
    if (spoiler && !spoiler.classList.contains('revealed')) {
      reveal(spoiler);
      return;
    }

    const img = target.closest<HTMLImageElement>('.prose img');
    if (img && !img.closest('a')) openLightbox(img);
  });
</script>

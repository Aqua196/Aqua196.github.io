---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base title="404">
  <div class="container wrap">
    <h1 class="mono"><span data-scramble data-scramble-load>404</span></h1>
    <pre class="term mono">$ curl {Astro.url.pathname}
Segmentation fault (core dumped)

[!] 页面不存在，或者已经被 free 掉了。</pre>
    <a class="btn btn-primary" href={url('/')}>cd ~</a>
  </div>
</Base>

<style>
  .wrap {
    padding-top: 12vh;
  }
  h1 {
    margin: 0;
    font-size: clamp(6rem, 26vw, 14rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.07em;
  }
  .term {
    margin: 2rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--fg-2);
    white-space: pre-wrap;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base title="404" noindex>
  <div class="container wrap">
    <p class="label">Error · Not Found</p>
    <h1>4<em>0</em>4</h1>
    <pre class="term mono"><span class="ps">$</span> curl <span id="missing-path">this-page</span>
<span class="err">Segmentation fault (core dumped)</span>

页面不存在，或者已经被 free 掉了。</pre>
    <div class="cta">
      <a class="btn btn-primary" href={url('/')}>回到首页 <span class="arr" aria-hidden="true">→</span></a>
      <button class="btn" type="button" data-open-search>搜索文章</button>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-top: 10vh;
  }
  h1 {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(8rem, 30vw, 17rem);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.03em;
  }
  h1 em {
    color: var(--accent);
  }
  .term {
    max-width: 34rem;
    margin: 2.5rem 0 2rem;
    padding: 1.1rem 1.3rem;
    font-size: 0.85rem;
    color: var(--fg-2);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .ps {
    color: var(--accent);
  }
  .err {
    color: oklch(var(--tone-l) var(--tone-c) 25);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

<script>
  // 404 页是同一个静态文件，访问的真实路径只能在浏览器里拿到
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('missing-path');
    if (el) el.textContent = decodeURI(location.pathname);
  });
</script>

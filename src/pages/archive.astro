---
import Base from '../layouts/Base.astro';
import Empty from '../components/Empty.astro';
import Kinetic from '../components/Kinetic.astro';
import { getPosts, categoryMeta, formatDate, type Post } from '../utils/posts';
import { postUrl } from '../utils/url';

const posts = await getPosts();
const byYear = new Map<string, Post[]>();
for (const p of posts) {
  const y = formatDate(p.data.date).slice(0, 4);
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}

// ---------- 每年一条日历热力带：一列是一周，一格是一天 ----------
const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function calendar(year: number, list: Post[]) {
  // 用 UTC 做纯日期运算，避开时区和夏令时；文章落在哪一天以 formatDate（东八区）为准
  const first = Date.UTC(year, 0, 1);
  const offset = new Date(first).getUTCDay();
  const length = (Date.UTC(year + 1, 0, 1) - first) / 86400000;
  const byDay = new Map<string, Post[]>();
  for (const p of list) {
    const key = formatDate(p.data.date);
    byDay.set(key, [...(byDay.get(key) ?? []), p]);
  }
  const cells = Array.from({ length }, (_, d) => {
    const date = new Date(first + d * 86400000);
    const key = date.toISOString().slice(0, 10);
    return { key, x: Math.floor((d + offset) / 7) * STEP, y: ((d + offset) % 7) * STEP, posts: byDay.get(key) ?? [] };
  });
  const months = MONTHS.map((label, m) => {
    const d = (Date.UTC(year, m, 1) - first) / 86400000;
    return { label, x: Math.floor((d + offset) / 7) * STEP };
  });
  return { cells, months, width: Math.ceil((length + offset) / 7) * STEP - GAP, height: 7 * STEP - GAP };
}
---

<Base title="归档" description="所有 writeup 的时间线">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow" data-reveal>git log --oneline</div>
      <h1><Kinetic text="Archive" /></h1>
      <p data-reveal style="--delay:.1s">共 {posts.length} 篇，按时间倒序。每个点是一天，亮起来的那天有文章。</p>
    </header>

    {posts.length === 0 && <Empty cmd="git log --oneline" />}
    {
      [...byYear].map(([year, list]) => {
        const cal = calendar(Number(year), list);
        return (
          <section class="year">
            <h2 class="y" data-reveal>
              {year}
              <small class="mono">{String(list.length).padStart(2, '0')} posts</small>
            </h2>
            <div class="main">
              <div class="cal" data-reveal>
                <svg viewBox={`0 -16 ${cal.width} ${cal.height + 16}`} role="group" aria-label={`${year} 年的发文日历，共 ${list.length} 篇`}>
                  {cal.months.map((m) => (
                    <text class="month" x={m.x} y="-6">
                      {m.label}
                    </text>
                  ))}
                  {cal.cells.map((c) =>
                    c.posts.length ? (
                      <a href={postUrl(c.posts[0].id)} data-day={c.key} data-tone style={`--h:${categoryMeta(c.posts[0].data.category).hue}`}>
                        <title>{`${c.key} · ${c.posts.map((p) => p.data.title).join(' / ')}`}</title>
                        <rect class="day on" x={c.x} y={c.y} width={CELL} height={CELL} rx="2.5" />
                      </a>
                    ) : (
                      <rect class="day" x={c.x} y={c.y} width={CELL} height={CELL} rx="2.5" />
                    ),
                  )}
                </svg>
              </div>
              <ol>
                {list.map((p, i) => {
                  const cat = categoryMeta(p.data.category);
                  return (
                    <li data-reveal data-tone data-day={formatDate(p.data.date)} style={`--h:${cat.hue};--delay:${Math.min(i, 10) * 0.03}s`}>
                      <a href={postUrl(p.id)}>
                        <time class="mono" datetime={p.data.date.toISOString()}>
                          {formatDate(p.data.date).slice(5)}
                        </time>
                        <span class="t">{p.data.title}</span>
                        <span class="chip">{cat.label}</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .year {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem 2rem;
    padding-top: 1.6rem;
    margin-bottom: 3.5rem;
    border-top: 1px solid var(--line);
  }
  .y {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
    margin: 0;
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .y small {
    display: block;
    margin-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* 网格子项默认不会缩到比内容窄：不加这句，下面那条可横向滚动的日历会把整页撑宽 */
  .main {
    min-width: 0;
  }

  /* ---------- 日历热力带 ---------- */
  .cal {
    margin: 0.3rem 0 1.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cal::-webkit-scrollbar {
    display: none;
  }
  .cal svg {
    display: block;
    width: 100%;
    min-width: 560px;
    max-width: 760px;
    height: auto;
    overflow: visible;
  }
  .month {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--muted);
  }
  .day {
    fill: var(--line);
    transition: fill 0.2s;
  }
  .day.on {
    fill: var(--cat);
    stroke: var(--cat);
    stroke-width: 0;
    transition: stroke-width 0.2s var(--ease);
  }
  /* 和下面的列表互相点亮：悬停一边，另一边对应的那天 / 那篇也亮 */
  .cal a:hover .day,
  .cal a:focus-visible .day,
  .cal a:global(.hl) .day {
    stroke-width: 4;
  }
  .cal a:focus-visible {
    outline: none;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  li a {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: baseline;
    padding: 0.95rem 1rem;
    margin: 0 -1rem;
    border-radius: var(--radius-sm);
    transition: background 0.2s;
  }
  li a:hover,
  li:global(.hl) a {
    background: var(--bg-2);
  }
  time {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .t {
    font-weight: 550;
    line-height: 1.5;
    transition: color 0.2s;
  }
  li a:hover .t,
  li:global(.hl) .t {
    color: var(--cat);
  }
  @media (max-width: 720px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
    }
    .y {
      position: static;
      display: flex;
      align-items: baseline;
      gap: 1rem;
      font-size: 3rem;
    }
    .y small {
      margin: 0;
    }
    li a {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.3rem 0.8rem;
      padding: 0.9rem 0.6rem;
      margin: 0 -0.6rem;
    }
    li .chip {
      grid-column: 2;
    }
  }
</style>

<script>
  // 日历上的点和列表里的条目互相高亮：两边都带着 data-day，靠它配对
  function link(e: Event, on: boolean) {
    const el = (e.target as Element).closest?.<HTMLElement>('.year [data-day]');
    if (!el) return;
    const year = el.closest('.year')!;
    year.querySelectorAll(`[data-day="${el.dataset.day}"]`).forEach((other) => {
      if (other !== el) other.classList.toggle('hl', on);
    });
  }
  document.addEventListener('pointerover', (e) => link(e, true));
  document.addEventListener('pointerout', (e) => link(e, false));
  document.addEventListener('focusin', (e) => link(e, true));
  document.addEventListener('focusout', (e) => link(e, false));
</script>

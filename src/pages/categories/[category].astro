---
import Kinetic from '../../components/Kinetic.astro';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, categoryMeta, type Post } from '../../utils/posts';
import { url, slugify } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  const keys = [...new Set(posts.map((p) => p.data.category))];
  return keys.map((category) => ({
    params: { category: slugify(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

interface Props {
  category: string;
  posts: Post[];
}
const { category, posts } = Astro.props;
const { label, hue } = categoryMeta(category);
---

<Base title={`分类 · ${label}`} description={`${label} 方向的全部 writeup`}>
  <div class="container" data-tone style={`--h:${hue}`}>
    <header class="page-head">
      <div class="eyebrow" data-reveal>cd ./categories/{category}</div>
      <h1><Kinetic text={label} /><i class="ch" aria-hidden="true" style={`--i:${label.length}`}>.</i></h1>
      <p data-reveal style="--delay:.1s">
        共 {posts.length} 篇 · <a href={url('/categories')}>全部分类</a>
      </p>
    </header>
    <ol class="post-list">
      {posts.map((post, i) => <PostRow post={post} index={i} />)}
    </ol>
  </div>
</Base>

<style>
  h1 i {
    color: var(--cat);
  }
</style>

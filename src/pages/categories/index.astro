---
import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import { getPosts, countBy, categoryMeta } from '../../utils/posts';
import { categoryUrl, postUrl } from '../../utils/url';

const posts = await getPosts();
const cats = countBy(posts, (p) => p.data.category);
---

<Base title="分类" description="按方向浏览 writeup">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow" data-reveal>ls ./categories</div>
      <h1 data-reveal style="--delay:.05s">Categories</h1>
      <p data-reveal style="--delay:.1s">{cats.length} 个方向。</p>
    </header>

    {cats.length === 0 && <Empty cmd="ls ./categories" />}
    <div class="grid" data-reveal style="--delay:.15s">
      {
        cats.map(([key, n]) => {
          const recent = posts.filter((p) => p.data.category === key).slice(0, 3);
          const cat = categoryMeta(key);
          return (
            <section class="cat" data-tone style={`--h:${cat.hue}`}>
              <a class="head" href={categoryUrl(key)}>
                <span class="chip">{String(n).padStart(2, '0')} posts</span>
                <h2>{cat.label}</h2>
                <span class="go" aria-hidden="true">→</span>
              </a>
              <ul>
                {recent.map((p) => (
                  <li>
                    <a href={postUrl(p.id)}>{p.data.title}</a>
                  </li>
                ))}
              </ul>
              {n > recent.length && (
                <a class="more-link" href={categoryUrl(key)}>
                  还有 {n - recent.length} 篇
                </a>
              )}
            </section>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .grid:not(:has(*)) {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }
  .cat {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.3rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s;
  }
  /* 右上角一抹分类色 */
  .cat::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 100% 0%, color-mix(in oklch, var(--cat) 12%, transparent), transparent 70%);
    pointer-events: none;
  }
  .cat:hover {
    border-color: var(--cat-line);
  }
  .head {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 0.2rem 1rem;
    margin-bottom: 1.2rem;
  }
  .head .chip {
    grid-column: 1 / -1;
    margin-bottom: 1.4rem;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1;
    transition: color 0.2s;
  }
  .head:hover h2 {
    color: var(--cat);
  }
  .go {
    color: var(--cat);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.2s, transform 0.3s var(--ease);
  }
  .head:hover .go {
    opacity: 1;
    transform: none;
  }
  ul {
    position: relative;
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  li a {
    color: var(--fg-2);
    transition: color 0.2s;
  }
  li a:hover {
    color: var(--fg);
  }
  .more-link {
    position: relative;
    margin-top: 0.8rem;
  }
</style>

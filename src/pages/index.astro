---
import Base from '../layouts/Base.astro';
import Opening from '../components/Opening.astro';
import PostRow from '../components/PostRow.astro';
import Empty from '../components/Empty.astro';
import { SITE } from '../config';
import { getHomePosts, countBy, tagGroups, categoryMeta } from '../utils/posts';
import { url, categoryUrl } from '../utils/url';

const posts = await getHomePosts();
const counts = new Map(countBy(posts, (p) => p.data.category));
const tags = tagGroups(posts);
const latest = posts.slice(0, SITE.homePostCount);
---

<Base>
  <Opening postCount={posts.length} categoryCount={counts.size} tagCount={tags.length} counts={counts} />

  <section class="container block" id="latest">
    <div class="section-head" data-reveal>
      <h2>Latest<span class="zh">最新文章</span></h2>
      {posts.length > 0 && <a class="more-link" href={url('/archive')}>view all</a>}
    </div>
    {
      /* 开场的章节只讲了五个方向；这一行是所有有文章的分类，Misc / Forensics 之类的从这里进 */
      counts.size > 1 && (
        <nav class="dirs" aria-label="按分类浏览" data-reveal>
          {[...counts].map(([key, n]) => {
            const cat = categoryMeta(key);
            return (
              <a class="chip boxed" href={categoryUrl(key)} data-tone style={`--h:${cat.hue}`}>
                {cat.label}
                <span class="count">{n}</span>
              </a>
            );
          })}
        </nav>
      )
    }
    {
      latest.length > 0 ? (
        <ol class="post-list">
          {latest.map((post, i) => (
            <PostRow post={post} index={i} />
          ))}
        </ol>
      ) : (
        <Empty>第一篇 writeup 正在路上。</Empty>
      )
    }
    {
      posts.length > latest.length && (
        <div class="more">
          <a class="btn" href={url('/archive')}>
            查看全部 {posts.length} 篇 <span class="arr" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </section>
</Base>

<style>
  .block {
    margin-top: 2rem;
  }
  .more {
    margin-top: 2rem;
  }
  .dirs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.4rem 0 1.4rem;
  }
  .dirs .count {
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
</style>

---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Difficulty from '../../components/Difficulty.astro';
import { getPosts, categoryMeta, formatDate, readingStats, type Post } from '../../utils/posts';
import { postUrl, tagUrl, categoryUrl } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = categoryMeta(d.category);
const { words, minutes } = readingStats(post.body);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label');
const hasChal = d.event || d.difficulty || d.points != null || d.solves != null || d.source;
---

<Base title={d.title} description={d.description} type="article" published={d.date} modified={d.updated}>
  <div class="progress" id="read-progress" aria-hidden="true"></div>

  <article class="container post">
    <header class="post-head">
      <div class="crumbs" data-reveal>
        <a class="badge" href={categoryUrl(d.category)}>{cat.label}</a>
        {d.draft && <span class="badge">Draft</span>}
      </div>
      <h1 transition:name={`post-title-${post.id}`}>{d.title}</h1>
      {d.description && <p class="desc" data-reveal>{d.description}</p>}
      <div class="meta mono" data-reveal>
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {d.updated && <span>updated {formatDate(d.updated)}</span>}
        <span>{minutes} min read</span>
        <span>{words.toLocaleString()} 字</span>
      </div>
    </header>

    {
      hasChal && (
        <dl class="spec" data-reveal>
          {d.event && (
            <div class="wide">
              <dt>Event</dt>
              <dd>{d.event}</dd>
            </div>
          )}
          <div>
            <dt>Category</dt>
            <dd>{cat.label}</dd>
          </div>
          {d.difficulty && (
            <div>
              <dt>Difficulty</dt>
              <dd>
                <Difficulty value={d.difficulty} />
              </dd>
            </div>
          )}
          {d.points != null && (
            <div>
              <dt>Points</dt>
              <dd>{d.points}</dd>
            </div>
          )}
          {d.solves != null && (
            <div>
              <dt>Solves</dt>
              <dd>{d.solves}</dd>
            </div>
          )}
          {d.source && (
            <div>
              <dt>Source</dt>
              <dd>
                <a class="src" href={d.source} target="_blank" rel="noopener">
                  原题链接 ↗
                </a>
              </dd>
            </div>
          )}
        </dl>
      )
    }

    <div class:list={['layout', { 'no-toc': toc.length === 0 }]}>
      <div class="prose" id="prose">
        {
          toc.length > 0 && (
            <details class="toc-mobile">
              <summary class="label">Contents · {toc.length}</summary>
              <ol>
                {toc.map((h) => (
                  <li class={`d${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
        <Content />
      </div>
      {toc.length > 0 && <Toc headings={toc} />}
    </div>

    <footer class="post-foot">
      {
        d.tags.length > 0 && (
          <div class="tags mono">
            {d.tags.map((t) => (
              <a href={tagUrl(t)}>#{t}</a>
            ))}
          </div>
        )
      }
      <div class="eof mono">EOF</div>
      <nav class="pager" aria-label="上一篇 / 下一篇">
        {
          older ? (
            <a class="pg" href={postUrl(older.id)}>
              <span class="label">← Prev</span>
              <span class="t">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a class="pg next" href={postUrl(newer.id)}>
              <span class="label">Next →</span>
              <span class="t">{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>

<style>
  .progress {
    position: fixed;
    top: calc(var(--header-h) - 1px);
    left: 0;
    z-index: 60;
    height: 2px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: var(--fg);
  }
  .post-head {
    max-width: 820px;
    padding: 4rem 0 2rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
  }
  h1 {
    text-wrap: balance;
    margin: 1.2rem 0 1rem;
    font-size: clamp(1.9rem, 5vw, 3rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .desc {
    margin: 0 0 1.4rem;
    font-size: 1.05rem;
    color: var(--fg-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .meta > * + *::before {
    content: '/';
    margin: 0 0.7rem;
    opacity: 0.5;
  }

  /* ---------- 题目信息：像规格表一样的格子 ---------- */
  .spec {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    max-width: 820px;
    margin: 0 0 3rem;
    border-top: 1px solid var(--fg);
    border-left: 1px solid var(--line);
  }
  .spec > * {
    padding: 0.8rem 1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .spec .wide {
    grid-column: span 2;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 0.25rem 0 0;
    font-weight: 600;
  }
  .src {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .src:hover {
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
  }

  /* ---------- 正文 + 目录 ---------- */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 4rem;
    align-items: start;
  }
  .layout.no-toc {
    grid-template-columns: minmax(0, 820px);
  }
  .prose {
    max-width: 820px;
    min-width: 0;
  }
  .toc-mobile {
    display: none;
    margin-bottom: 2.5rem;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--line);
    padding: 0.7rem 0;
  }
  .toc-mobile summary {
    cursor: pointer;
    color: var(--fg);
  }
  .toc-mobile ol {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
  }
  .toc-mobile li {
    margin: 0.3rem 0;
    font-size: 0.92rem;
  }
  .toc-mobile .d3 {
    padding-left: 1rem;
  }
  .toc-mobile a {
    text-decoration: none;
    color: var(--fg-2);
  }
  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc-mobile {
      display: block;
    }
  }

  /* ---------- 文末 ---------- */
  .post-foot {
    max-width: 820px;
    margin-top: 4rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags a {
    font-size: 0.8rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line-2);
    transition: background 0.12s, color 0.12s;
  }
  .tags a:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .eof {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .eof::before,
  .eof::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--line-2);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--fg);
  }
  .pg {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1rem 1.2rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.12s, color 0.12s;
  }
  .pg:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .pg:hover .label {
    color: inherit;
    opacity: 0.7;
  }
  .pg.next {
    grid-column: 2;
    text-align: right;
    border-left: 1px solid var(--line);
  }
  .t {
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pg.next {
      grid-column: 1;
      border-left: none;
    }
    .spec .wide {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  function initProgress() {
    const bar = document.getElementById('read-progress');
    const prose = document.getElementById('prose');
    if (!bar || !prose) return;
    const update = () => {
      const r = prose.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    const onScroll = () => requestAnimationFrame(update);
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), {
      once: true,
    });
  }
  document.addEventListener('astro:page-load', initProgress);
</script>

---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/prose.css';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Difficulty from '../../components/Difficulty.astro';
import { getPosts, categoryMeta, formatDate, readingStats, type Post } from '../../utils/posts';
import { postUrl, tagUrl, categoryUrl } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = categoryMeta(d.category);
const { words, minutes } = readingStats(post.body);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3 && h.slug !== 'footnote-label');
const hasChal = d.event || d.difficulty || d.points != null || d.solves != null || d.source;
---

<Base title={d.title} description={d.description} type="article" published={d.date} modified={d.updated}>
  <div class="progress" id="read-progress" aria-hidden="true"></div>

  <article class="post" data-tone style={`--h:${cat.hue}`}>
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <header class="post-head">
        <div class="crumbs" data-reveal>
          <a class="chip boxed" href={categoryUrl(d.category)}>{cat.label}</a>
          {d.draft && <span class="chip boxed plain draft">Draft</span>}
        </div>
        <h1 transition:name={`post-title-${post.id}`}>{d.title}</h1>
        {d.description && <p class="desc" data-reveal>{d.description}</p>}
        <div class="meta mono" data-reveal>
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          {d.updated && <span>updated {formatDate(d.updated)}</span>}
          <span>{minutes} min read</span>
          <span>{words.toLocaleString()} 字</span>
        </div>
      </header>

      {
        hasChal && (
          <dl class="spec" data-reveal>
            {d.event && (
              <div class="wide">
                <dt>Event</dt>
                <dd>{d.event}</dd>
              </div>
            )}
            {d.difficulty && (
              <div>
                <dt>Difficulty</dt>
                <dd>
                  <Difficulty value={d.difficulty} />
                  <span class="of mono">{d.difficulty}/5</span>
                </dd>
              </div>
            )}
            {d.points != null && (
              <div>
                <dt>Points</dt>
                <dd class="num">{d.points}</dd>
              </div>
            )}
            {d.solves != null && (
              <div>
                <dt>Solves</dt>
                <dd class="num">{d.solves}</dd>
              </div>
            )}
            {d.source && (
              <div>
                <dt>Source</dt>
                <dd>
                  <a class="src" href={d.source} target="_blank" rel="noopener">
                    原题链接 <span aria-hidden="true">↗</span>
                  </a>
                </dd>
              </div>
            )}
          </dl>
        )
      }

      <div class:list={['layout', { 'no-toc': toc.length === 0 }]}>
        <div class="prose" id="prose">
          {
            toc.length > 0 && (
              <details class="toc-mobile">
                <summary>
                  <span class="label">目录 · {toc.length}</span>
                </summary>
                <ol>
                  {toc.map((h) => (
                    <li class={`d${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </details>
            )
          }
          <Content />
        </div>
        {toc.length > 0 && <Toc headings={toc} />}
      </div>

      <footer class="post-foot">
        {
          d.tags.length > 0 && (
            <div class="tags">
              {d.tags.map((t) => (
                <a class="tag" href={tagUrl(t)}>
                  {t}
                </a>
              ))}
            </div>
          )
        }
        <div class="eof mono" aria-hidden="true">EOF</div>
        <nav class="pager" aria-label="上一篇 / 下一篇">
          {
            older ? (
              <a class="pg" href={postUrl(older.id)} data-spot>
                <span class="label">← 上一篇</span>
                <span class="t">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a class="pg next" href={postUrl(newer.id)} data-spot>
                <span class="label">下一篇 →</span>
                <span class="t">{newer.data.title}</span>
              </a>
            )
          }
        </nav>
      </footer>
    </div>
  </article>
</Base>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    height: 2px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: var(--accent);
  }
  .post {
    position: relative;
  }
  /* 页头背后一抹分类色：让每个方向的文章有自己的气质 */
  .glow {
    position: absolute;
    inset: 0 0 auto;
    height: 26rem;
    z-index: -1;
    background: radial-gradient(60% 100% at 18% 0%, color-mix(in oklch, var(--cat) 13%, transparent), transparent 70%);
    pointer-events: none;
  }
  .post-head {
    max-width: 820px;
    padding: 4.5rem 0 2.2rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
  }
  .draft {
    color: var(--muted);
    border-style: dashed;
    border-color: var(--line-2);
    background: none;
  }
  h1 {
    text-wrap: balance;
    margin: 1.5rem 0 1.1rem;
    font-size: clamp(2rem, 5.2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }
  .desc {
    margin: 0 0 1.6rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--fg-2);
    text-wrap: pretty;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .meta > * + *::before {
    content: '·';
    margin: 0 0.8rem;
  }

  /* ---------- 题目信息 ---------- */
  .spec {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 0;
    max-width: 820px;
    margin: 0 0 3.5rem;
    padding: 1.2rem 0;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .spec > div {
    flex: 1 1 7.5rem;
    padding: 0 1.4rem;
    border-left: 1px solid var(--line);
    /* 换行后每行第一格的左边线藏到卡片外面去 */
    margin-left: -1px;
  }
  .spec .wide {
    flex: 2 1 13rem;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.35rem 0 0;
    min-height: 1.7rem;
    font-weight: 600;
  }
  dd.num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
  }
  .of {
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--muted);
  }
  .src {
    color: var(--cat);
    text-decoration: underline;
    text-decoration-color: var(--cat-line);
    text-underline-offset: 4px;
  }
  .src:hover {
    text-decoration-color: currentColor;
  }

  /* ---------- 正文 + 目录 ---------- */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 820px) minmax(0, 220px);
    justify-content: space-between;
    gap: 3rem;
    align-items: start;
  }
  .layout.no-toc {
    grid-template-columns: minmax(0, 820px);
    justify-content: start;
  }
  .prose {
    min-width: 0;
  }
  .toc-mobile {
    display: none;
    margin-bottom: 2.5rem;
    padding: 0.85rem 1.1rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .toc-mobile summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .toc-mobile[open] summary::after {
    content: '−';
  }
  .toc-mobile summary .label {
    color: var(--fg-2);
  }
  .toc-mobile ol {
    list-style: none;
    padding: 0;
    margin: 0.7rem 0 0.2rem;
  }
  .toc-mobile li {
    margin: 0.35rem 0;
    font-size: 0.92rem;
  }
  .toc-mobile .d3 {
    padding-left: 1rem;
  }
  .toc-mobile a {
    text-decoration: none;
    color: var(--fg-2);
  }
  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 820px);
      justify-content: start;
    }
    .toc-mobile {
      display: block;
    }
  }

  /* ---------- 文末 ---------- */
  .post-foot {
    max-width: 820px;
    margin-top: 4rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .eof {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .eof::before,
  .eof::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--line-2);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .pg {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem 1.3rem 1.3rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.25s, transform 0.3s var(--ease);
  }
  .pg:hover {
    transform: translateY(-2px);
  }
  .pg:hover .label {
    color: var(--accent);
  }
  .pg .label {
    transition: color 0.2s;
  }
  .pg.next {
    grid-column: 2;
    text-align: right;
  }
  .t {
    font-weight: 600;
    line-height: 1.5;
    text-wrap: balance;
  }
  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pg.next {
      grid-column: 1;
    }
    .post-head {
      padding-top: 3rem;
    }
  }
</style>

<script>
  function initProgress() {
    const bar = document.getElementById('read-progress');
    const prose = document.getElementById('prose');
    if (!bar || !prose) return;
    const update = () => {
      const r = prose.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    const onScroll = () => requestAnimationFrame(update);
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), {
      once: true,
    });
  }
  // 给每个二、三级标题加一个锚点：悬停出现，点击复制这一节的链接
  function initAnchors() {
    document.querySelectorAll<HTMLElement>('#prose :is(h2, h3)[id]').forEach((h) => {
      if (h.querySelector('.anchor') || h.closest('.footnotes')) return;
      const a = document.createElement('a');
      a.className = 'anchor';
      a.href = `#${h.id}`;
      a.textContent = '#';
      a.setAttribute('aria-label', `复制“${h.textContent}”这一节的链接`);
      a.addEventListener('click', () => {
        navigator.clipboard?.writeText(new URL(`#${h.id}`, location.href).href).then(() => {
          a.classList.add('copied');
          setTimeout(() => a.classList.remove('copied'), 1400);
        });
      });
      h.append(a);
    });
  }
  document.addEventListener('astro:page-load', initProgress);
  document.addEventListener('astro:page-load', initAnchors);
</script>

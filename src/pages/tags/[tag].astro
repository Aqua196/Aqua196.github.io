---
import Kinetic from '../../components/Kinetic.astro';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, tagGroups, type Post } from '../../utils/posts';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  return tagGroups(await getPosts()).map(({ slug, name, posts }) => ({
    params: { tag: slug },
    props: { name, posts },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}
const { name: tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`标签 ${tag} 下的 writeup`}>
  <div class="container">
    <header class="page-head">
      <div class="eyebrow" data-reveal>grep -rl "#{tag}" ./writeups</div>
      <h1><i class="ch" aria-hidden="true" style="--i:0">#</i><Kinetic text={tag} offset={1} /></h1>
      <p data-reveal style="--delay:.1s">
        共 {posts.length} 篇 · <a href={url('/tags')}>全部标签</a>
      </p>
    </header>
    <ol class="post-list">
      {posts.map((post, i) => <PostRow post={post} index={i} />)}
    </ol>
  </div>
</Base>

<style>
  h1 i {
    color: var(--accent);
    margin-right: 0.08em;
  }
</style>

---
import Kinetic from '../../components/Kinetic.astro';
import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import { getPosts, tagGroups } from '../../utils/posts';
import { tagUrl } from '../../utils/url';

const tags = tagGroups(await getPosts());
const counts = tags.map((t) => t.posts.length);
const min = Math.min(...counts);
const max = Math.max(...counts);
// 按最少~最多归一化；大家次数都一样时统一用基础字号
const size = (n: number) => (0.9 + ((n - min) / (max - min || 1)) * 1.1).toFixed(2);
---

<Base title="标签" description="所有标签">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow" data-reveal>sort tags | uniq -c</div>
      <h1><Kinetic text="Tags" /></h1>
      <p data-reveal style="--delay:.1s">{tags.length} 个标签，字越大用得越多。</p>
    </header>

    {
      tags.length > 0 ? (
        <div class="cloud" data-reveal style="--delay:.15s">
          {tags.map((t) => (
            <a class="tag" href={tagUrl(t.name)} style={`--s:${size(t.posts.length)}rem`}>
              {t.name}
              <span class="n">{t.posts.length}</span>
            </a>
          ))}
        </div>
      ) : (
        <Empty cmd="sort tags | uniq -c" />
      )
    }
  </div>
</Base>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    max-width: 920px;
  }
  .tag {
    font-size: var(--s);
  }
</style>

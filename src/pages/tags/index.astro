---
import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import { getPosts, tagGroups } from '../../utils/posts';
import { tagUrl } from '../../utils/url';

const tags = tagGroups(await getPosts());
const counts = tags.map((t) => t.posts.length);
const min = Math.min(...counts);
const max = Math.max(...counts);
// 按最少~最多归一化；大家次数都一样时统一用基础字号
const size = (n: number) => (0.9 + ((n - min) / (max - min || 1)) * 1.1).toFixed(2);
---

<Base title="标签" description="所有标签">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow" data-reveal>$ sort tags | uniq -c</div>
      <h1 data-reveal style="--delay:.05s"><span data-scramble data-scramble-load>Tags</span></h1>
      <p data-reveal style="--delay:.1s">{tags.length} 个标签，字越大用得越多。</p>
    </header>

    {
      tags.length > 0 ? (
        <div class="cloud mono" data-reveal style="--delay:.15s">
          {tags.map((t) => (
            <a href={tagUrl(t.name)} style={`--s:${size(t.posts.length)}rem`}>
              #{t.name}
              <sup>{t.posts.length}</sup>
            </a>
          ))}
        </div>
      ) : (
        <Empty cmd="sort tags | uniq -c" />
      )
    }
  </div>
</Base>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.6rem;
    max-width: 900px;
  }
  a {
    font-size: var(--s);
    padding: 0.15em 0.5em;
    border: 1px solid var(--line-2);
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }
  a:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  sup {
    font-size: 0.6em;
    margin-left: 0.15em;
    opacity: 0.55;
  }
</style>
